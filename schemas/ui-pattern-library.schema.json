{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litenova.nl/standards/schemas/ui-pattern-library.schema.json",
  "title": "UI pattern library",
  "description": "The standards' library of recurring UI patterns: for each, the question it answers, the options drawn, the recommended option, and its compact-screen behaviour. Generated from the drawn items under patterns/ui/items; a consumer's pattern catalog cites it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schemaVersion", "breakpoints", "groups", "patterns"],
  "properties": {
    "$schema": { "type": "string" },
    "kind": { "const": "ui-pattern-library" },
    "schemaVersion": { "const": 1 },
    "breakpoints": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["page-frame", "element", "scenario"] }
        }
      }
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "group", "title", "question", "options", "recommended", "compact"],
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "group": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "question": { "type": "string", "minLength": 1 },
          "options": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "name", "rationale", "cost"],
              "properties": {
                "id": { "$ref": "#/$defs/slug" },
                "name": { "type": "string", "minLength": 1 },
                "rationale": { "type": "string", "minLength": 1 },
                "cost": { "type": "string", "minLength": 1 },
                "reference": { "type": "string" }
              }
            }
          },
          "recommended": { "$ref": "#/$defs/slug" },
          "compact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["breakpoint", "behaviour"],
            "properties": {
              "breakpoint": { "type": "string" },
              "option": { "$ref": "#/$defs/slug" },
              "behaviour": { "type": "string", "minLength": 1 }
            }
          },
          "assessment": { "type": "string", "description": "Which option to prefer, the runner-up and when, and what never to ship." }
        }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
  }
}
