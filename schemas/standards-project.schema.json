{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/standards-project.schema.json",
  "title": "Litenova Standards Consumer Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "profile", "reviewedStandardsVersion", "paths", "selectedExtensions", "overrides"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "reviewedStandardsVersion": {
      "description": "The standards release whose complete contract this project last reviewed.",
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domainDocs", "uiDocs", "frontends"],
      "properties": {
        "apiSolution": {
          "description": "Path to the API solution. A consumer with no backend omits it and records a SCOPE.BACKEND.001 decision.",
          "$ref": "#/$defs/projectPath"
        },
        "domainDocs": { "$ref": "#/$defs/projectPath" },
        "uiDocs": { "$ref": "#/$defs/projectPath" },
        "frontends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "path": { "$ref": "#/$defs/projectPath" },
              "platform": {
                "type": "string",
                "enum": ["react-web", "react-native", "other-web"]
              },
              "ui": { "$ref": "#/$defs/ui" }
            },
            "allOf": [
              {
                "if": { "required": ["ui"] },
                "then": {
                  "required": ["platform"],
                  "properties": { "platform": { "const": "react-web" } }
                }
              },
              {
                "if": {
                  "properties": { "platform": { "const": "react-web" } },
                  "required": ["platform"]
                },
                "then": { "required": ["ui"] }
              }
            ]
          }
        }
      }
    },
    "selectedExtensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "decision"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z0-9]+){2,}$" },
          "decision": { "$ref": "#/$defs/projectPath" },
          "reviewBy": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": { "ruleId": { "pattern": "^UI\\." } },
              "required": ["ruleId"]
            },
            "then": { "required": ["reviewBy"] }
          }
        ]
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "publicExports"],
      "properties": {
        "profile": {
          "type": "string",
          "enum": ["public-light", "application-balanced", "admin-dense"]
        },
        "system": {
          "type": "string",
          "enum": ["shadcn/ui", "bootstrap", "mui", "other"]
        },
        "styling": { "type": "string", "minLength": 1 },
        "base": { "enum": ["base-ui", "radix-ui"] },
        "style": { "type": "string", "minLength": 1 },
        "presetCode": { "type": "string", "minLength": 1 },
        "presetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "cssVariables": { "type": "boolean" },
        "baseColor": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "chartColor": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "minLength": 1 },
        "fontHeading": { "type": "string", "minLength": 1 },
        "icons": { "type": "string", "minLength": 1 },
        "radius": { "type": "string", "minLength": 1 },
        "menuAccent": { "enum": ["subtle", "bold"] },
        "menuColor": { "enum": ["default", "inverted", "default-translucent", "inverted-translucent"] },
        "componentsStyle": { "type": "string", "minLength": 1 },
        "componentsJson": { "$ref": "#/$defs/projectPath" },
        "vocabulary": { "$ref": "#/$defs/projectPath" },
        "sourceLock": { "$ref": "#/$defs/projectPath" },
        "globalCss": { "$ref": "#/$defs/projectPath" },
        "primitives": { "$ref": "#/$defs/projectPath" },
        "publicExports": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "overrideDecision": { "$ref": "#/$defs/projectPath" },
        "reviewBy": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "system": { "const": "shadcn/ui" } }
          },
          "then": {
            "required": ["componentsJson", "vocabulary", "sourceLock", "globalCss", "primitives"]
          },
          "else": {
            "required": ["system", "overrideDecision", "reviewBy"]
          }
        }
      ]
    }
  }
}
