{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/standards-project.schema.json",
  "title": "Litenova Standards Consumer Project",
  "type": "object",
  "additionalProperties": false,
  "required": ["project", "profile", "paths", "selectedExtensions", "overrides"],
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 }
      }
    },
    "profile": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["apiSolution", "domainDocs", "uiDocs", "frontends"],
      "properties": {
        "apiSolution": { "$ref": "#/$defs/projectPath" },
        "domainDocs": { "$ref": "#/$defs/projectPath" },
        "uiDocs": { "$ref": "#/$defs/projectPath" },
        "frontends": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path"],
            "properties": {
              "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
              "path": { "$ref": "#/$defs/projectPath" }
            }
          }
        }
      }
    },
    "selectedExtensions": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ruleId", "decision"],
        "properties": {
          "ruleId": { "type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:\\.[A-Z0-9]+){2,}$" },
          "decision": { "$ref": "#/$defs/projectPath" }
        }
      }
    }
  },
  "$defs": {
    "projectPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
    }
  }
}
