{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/standards-manifest.schema.json",
  "title": "Litenova Engineering Standards Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "name",
    "agentsEntry",
    "defaultProfile",
    "paths",
    "provisionRegistry",
    "profiles",
    "extensions",
    "stack",
    "packages",
    "uiBaseline",
    "overridePolicy",
    "loadPlans"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 4 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": { "type": "string", "minLength": 1 },
    "agentsEntry": { "$ref": "#/$defs/repositoryPath" },
    "defaultProfile": { "$ref": "#/$defs/identifier" },
    "paths": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docs", "template", "extension"],
      "properties": {
        "docs": { "$ref": "#/$defs/repositoryPath" },
        "template": { "$ref": "#/$defs/repositoryPath" },
        "extension": { "$ref": "#/$defs/repositoryPath" }
      }
    },
    "provisionRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["areas", "topics"],
      "properties": {
        "areas": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idArea" }
        },
        "topics": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idArea" }
        }
      }
    },
    "overridePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiresReviewBy"],
      "properties": {
        "requiresReviewBy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/idScope" }
        }
      }
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry", "documents"],
        "properties": {
          "entry": { "$ref": "#/$defs/repositoryPath" },
          "documents": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/repositoryPath" }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/extension" }
    },
    "stack": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nuget", "npm"],
      "properties": {
        "nuget": { "$ref": "#/$defs/versionMap" },
        "npm": { "$ref": "#/$defs/versionMap" }
      }
    },
    "uiBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "system",
        "styling",
        "base",
        "style",
        "presetCode",
        "presetFingerprint",
        "cssVariables",
        "baseColor",
        "theme",
        "chartColor",
        "font",
        "fontHeading",
        "icons",
        "radius",
        "menuAccent",
        "menuColor",
        "componentsStyle",
        "sourceModel",
        "registry",
        "profiles",
        "nativeBoundary"
      ],
      "properties": {
        "platform": { "const": "react-web" },
        "system": { "const": "shadcn/ui" },
        "styling": { "const": "tailwindcss-v4" },
        "base": { "const": "base-ui" },
        "style": { "type": "string", "minLength": 1 },
        "presetCode": { "type": "string", "minLength": 1 },
        "presetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "cssVariables": { "const": true },
        "baseColor": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "chartColor": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "minLength": 1 },
        "fontHeading": { "type": "string", "minLength": 1 },
        "icons": { "const": "lucide" },
        "radius": { "type": "string", "minLength": 1 },
        "menuAccent": { "enum": ["subtle", "bold"] },
        "menuColor": { "enum": ["default", "inverted", "default-translucent", "inverted-translucent"] },
        "componentsStyle": { "type": "string", "minLength": 1 },
        "sourceModel": { "const": "per-frontend-owned-source" },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url", "allowAdditional"],
          "properties": {
            "name": { "const": "shadcn" },
            "url": { "const": "https://ui.shadcn.com" },
            "allowAdditional": { "const": false }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["public-light", "application-balanced", "admin-dense"]
          }
        },
        "nativeBoundary": { "const": "separate-platform-profile" },
        "compatibilityBases": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["radix-ui"] }
        }
      }
    },
    "loadPlans": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/loadPlan" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "idArea": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "idScope": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*\\.[A-Z][A-Z0-9]*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "versionMap": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "activationScope"],
      "properties": {
        "path": { "$ref": "#/$defs/repositoryPath" },
        "activationScope": {
          "type": "string",
          "enum": ["project", "local"]
        },
        "applicableKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["module", "use-case", "end-to-end-flow", "workflow", "domain-policy", "page"]
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "activationScope": { "const": "local" } },
            "required": ["activationScope"]
          },
          "then": { "required": ["applicableKinds"] },
          "else": { "not": { "required": ["applicableKinds"] } }
        }
      ]
    },
    "loadPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tier0", "tier1", "tier2"],
      "properties": {
        "tier0": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "tier1": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        },
        "tier2": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/repositoryPath" }
        }
      }
    }
  }
}
