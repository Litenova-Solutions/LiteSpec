{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://litespec.dev/2.0.0/schemas/litespec-manifest.schema.json",
  "title": "LiteSpec Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "name",
    "agentsEntry",
    "stacks",
    "shapes",
    "extensions",
    "uiBaseline"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$comment": "Each release pins one exact shape. A consumer adopting a later release absorbs every difference at that moment, so no minor-compatible range exists between two releases. See litespec/core/authoring#publish-each-release-as-a-complete-contract and litespec/core/authoring#exclude-cross-release-compatibility-work.",
      "const": 5
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "agentsEntry": {
      "$ref": "#/$defs/repositoryPath"
    },
    "stacks": {
      "description": "The stacks this release ships, by stack id.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "description": "One shipped stack: the folder whose pages apply when a consumer selects it.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "folder"
        ],
        "properties": {
          "folder": {
            "description": "The stack folder under docs/backend/ or docs/frontend/, holding a stack.md.",
            "$ref": "#/$defs/repositoryPath"
          },
          "requires": {
            "description": "Stacks a project must also select with this one.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          },
          "pairsWith": {
            "description": "The only backend stacks a frontend stack works beside; absent means any.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/identifier"
            }
          }
        }
      }
    },
    "shapes": {
      "description": "The project shapes this release ships, by shape id.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "description": "One project shape: how many backend stacks it names and which backend pages apply without one.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "backendStacks"
        ],
        "properties": {
          "backendStacks": {
            "description": "How many backend stacks a project of this shape names.",
            "type": "integer",
            "minimum": 0
          },
          "backendPages": {
            "description": "The pages directly in docs/backend/ that apply when the shape names no backend stack.",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/repositoryPath"
            }
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/extension"
      }
    },
    "stack": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nuget",
        "npm"
      ],
      "properties": {
        "nuget": {
          "$ref": "#/$defs/versionMap"
        },
        "npm": {
          "$ref": "#/$defs/versionMap"
        }
      }
    },
    "uiBaseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "system",
        "styling",
        "base",
        "style",
        "cssVariables",
        "baseColor",
        "theme",
        "chartColor",
        "font",
        "fontHeading",
        "icons",
        "radius",
        "menuAccent",
        "menuColor",
        "componentsStyle",
        "sourceModel",
        "registry",
        "profiles",
        "nativeBoundary"
      ],
      "properties": {
        "platform": {
          "const": "react"
        },
        "system": {
          "const": "shadcn/ui"
        },
        "styling": {
          "const": "tailwindcss-v4"
        },
        "base": {
          "const": "base-ui"
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "cssVariables": {
          "const": true
        },
        "baseColor": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "chartColor": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "fontHeading": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "const": "lucide"
        },
        "radius": {
          "type": "string",
          "minLength": 1
        },
        "menuAccent": {
          "enum": [
            "subtle",
            "bold"
          ]
        },
        "menuColor": {
          "enum": [
            "default",
            "inverted",
            "default-translucent",
            "inverted-translucent"
          ]
        },
        "componentsStyle": {
          "type": "string",
          "minLength": 1
        },
        "sourceModel": {
          "const": "shared-ui-package"
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "allowAdditional"
          ],
          "properties": {
            "name": {
              "const": "shadcn"
            },
            "url": {
              "const": "https://ui.shadcn.com"
            },
            "allowAdditional": {
              "type": "boolean"
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public-light",
              "application-balanced",
              "admin-dense"
            ]
          }
        },
        "nativeBoundary": {
          "const": "separate-platform-profile"
        }
      }
    },
    "uiBaselineSvelte": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "system",
        "styling",
        "base",
        "style",
        "cssVariables",
        "baseColor",
        "theme",
        "chartColor",
        "font",
        "fontHeading",
        "icons",
        "radius",
        "menuAccent",
        "menuColor",
        "componentsStyle",
        "sourceModel",
        "registry",
        "profiles",
        "nativeBoundary"
      ],
      "properties": {
        "platform": {
          "const": "svelte"
        },
        "system": {
          "const": "shadcn-svelte"
        },
        "styling": {
          "const": "tailwindcss-v4"
        },
        "base": {
          "const": "bits-ui"
        },
        "style": {
          "type": "string",
          "minLength": 1
        },
        "cssVariables": {
          "const": true
        },
        "baseColor": {
          "type": "string",
          "minLength": 1
        },
        "theme": {
          "type": "string",
          "minLength": 1
        },
        "chartColor": {
          "type": "string",
          "minLength": 1
        },
        "font": {
          "type": "string",
          "minLength": 1
        },
        "fontHeading": {
          "type": "string",
          "minLength": 1
        },
        "icons": {
          "const": "lucide"
        },
        "radius": {
          "type": "string",
          "minLength": 1
        },
        "menuAccent": {
          "enum": [
            "subtle",
            "bold"
          ]
        },
        "menuColor": {
          "enum": [
            "default",
            "inverted",
            "default-translucent",
            "inverted-translucent"
          ]
        },
        "componentsStyle": {
          "type": "string",
          "minLength": 1
        },
        "sourceModel": {
          "const": "shared-ui-package"
        },
        "registry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url",
            "allowAdditional"
          ],
          "properties": {
            "name": {
              "const": "shadcn-svelte"
            },
            "url": {
              "const": "https://shadcn-svelte.com/registry"
            },
            "allowAdditional": {
              "type": "boolean"
            }
          }
        },
        "profiles": {
          "type": "array",
          "minItems": 3,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "public-light",
              "application-balanced",
              "admin-dense"
            ]
          }
        },
        "nativeBoundary": {
          "const": "separate-platform-profile"
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "idArea": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9]*$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\.\\.)[^\\\\]+$"
    },
    "versionMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "recordType": {
      "type": "string",
      "enum": [
        "product",
        "constraint",
        "research",
        "goal",
        "decision",
        "requirement",
        "problem",
        "feature",
        "actor",
        "role",
        "permission",
        "journey",
        "module",
        "aggregate",
        "rule",
        "use-case",
        "result",
        "scenario",
        "event",
        "entry-point",
        "external-system",
        "limit",
        "runbook",
        "deviation",
        "known-gap",
        "term"
      ]
    },
    "provisionId": {
      "type": "string",
      "pattern": "^litespec/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)*#[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "activationScope"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "activationScope": {
          "type": "string",
          "enum": [
            "project",
            "local"
          ]
        },
        "applicableKinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recordType"
          }
        },
        "replaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/provisionId"
          }
        },
        "switchesOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/recordType"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "activationScope": {
                "const": "local"
              }
            },
            "required": [
              "activationScope"
            ]
          },
          "then": {
            "required": [
              "applicableKinds"
            ]
          },
          "else": {
            "not": {
              "required": [
                "applicableKinds"
              ]
            }
          }
        }
      ]
    }
  }
}
