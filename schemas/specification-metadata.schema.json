{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/specification-metadata.schema.json",
  "title": "Agentic Engineering System Specification Metadata",
  "description": "JSON metadata blocks embedded at the start of structured Agentic Engineering System specifications.",
  "oneOf": [
    { "$ref": "#/$defs/product" },
    { "$ref": "#/$defs/domainIndex" },
    { "$ref": "#/$defs/glossary" },
    { "$ref": "#/$defs/modulesIndex" },
    { "$ref": "#/$defs/module" },
    { "$ref": "#/$defs/useCase" },
    { "$ref": "#/$defs/endToEndFlow" },
    { "$ref": "#/$defs/workflow" },
    { "$ref": "#/$defs/domainPolicy" },
    { "$ref": "#/$defs/decisionEvidence" },
    { "$ref": "#/$defs/operatingLimits" },
    { "$ref": "#/$defs/page" },
    { "$ref": "#/$defs/decision" },
    { "$ref": "#/$defs/runbook" },
    { "$ref": "#/$defs/releaseRecord" }
  ],
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "recordIdentifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "useCaseIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "pageIdentifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "specStatus": {
      "type": "string",
      "enum": ["draft", "approved", "retired"]
    },
    "implementationStatus": {
      "type": "string",
      "enum": ["planned", "implemented", "verified"]
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "lastReviewed": {
      "type": "string",
      "format": "date"
    },
    "identifierArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "useCaseArray": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/useCaseIdentifier" }
    },
    "extensionArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/identifier" }
    },
    "riskArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "authorization",
          "money",
          "sensitive-data",
          "irreversible",
          "concurrency",
          "durable-delivery",
          "availability"
        ]
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed", "primaryReleaseFlow"],
      "properties": {
        "kind": { "const": "product" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "primaryReleaseFlow": { "$ref": "#/$defs/identifier" }
      }
    },
    "domainIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "domain-index" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "glossary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "glossary" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "modulesIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "modules-index" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "module" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "useCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "specStatus",
        "implementationStatus",
        "owner",
        "lastReviewed",
        "operationType",
        "actors",
        "entryPoints",
        "risks",
        "applicableExtensions"
      ],
      "properties": {
        "kind": { "const": "use-case" },
        "id": { "$ref": "#/$defs/useCaseIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "operationType": {
          "type": "string",
          "enum": ["command", "query"]
        },
        "actors": { "$ref": "#/$defs/identifierArray" },
        "entryPoints": { "$ref": "#/$defs/identifierArray" },
        "risks": { "$ref": "#/$defs/riskArray" },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "endToEndFlow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "specStatus",
        "implementationStatus",
        "owner",
        "lastReviewed",
        "releaseRole",
        "useCases"
      ],
      "properties": {
        "kind": { "const": "end-to-end-flow" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "releaseRole": {
          "type": "string",
          "enum": ["primary", "supporting"]
        },
        "useCases": { "$ref": "#/$defs/useCaseArray" },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "specStatus",
        "implementationStatus",
        "owner",
        "lastReviewed",
        "participatingModules",
        "applicableExtensions"
      ],
      "properties": {
        "kind": { "const": "workflow" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "participatingModules": {
          "allOf": [
            { "$ref": "#/$defs/identifierArray" },
            { "minItems": 1 }
          ]
        },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "domainPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed", "appliesToModules"],
      "properties": {
        "kind": { "const": "domain-policy" },
        "id": { "$ref": "#/$defs/identifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "appliesToModules": {
          "allOf": [
            { "$ref": "#/$defs/identifierArray" },
            { "minItems": 1 }
          ]
        },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "decisionEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "decision-evidence" },
        "id": { "$ref": "#/$defs/recordIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "operatingLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "operating-limits" },
        "id": { "$ref": "#/$defs/recordIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "specStatus",
        "implementationStatus",
        "owner",
        "lastReviewed",
        "app",
        "route",
        "useCases"
      ],
      "properties": {
        "kind": { "const": "page" },
        "id": { "$ref": "#/$defs/pageIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "implementationStatus": { "$ref": "#/$defs/implementationStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "app": { "$ref": "#/$defs/identifier" },
        "route": { "type": "string", "minLength": 1 },
        "useCases": { "$ref": "#/$defs/useCaseArray" },
        "applicableExtensions": { "$ref": "#/$defs/extensionArray" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "decision" },
        "id": { "$ref": "#/$defs/recordIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "runbook": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed"],
      "properties": {
        "kind": { "const": "runbook" },
        "id": { "$ref": "#/$defs/recordIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" }
      }
    },
    "releaseRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "specStatus", "owner", "lastReviewed", "release"],
      "properties": {
        "kind": { "const": "release-record" },
        "id": { "$ref": "#/$defs/recordIdentifier" },
        "specStatus": { "$ref": "#/$defs/specStatus" },
        "owner": { "$ref": "#/$defs/owner" },
        "lastReviewed": { "$ref": "#/$defs/lastReviewed" },
        "release": { "type": "string", "minLength": 1 }
      }
    }
  }
}
