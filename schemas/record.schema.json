{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/record.schema.json",
  "title": "Litenova Project Record Frontmatter",
  "description": "The JSON frontmatter block opening a consumer documentation page: one page record or one page style, with the entry records it carries.",
  "oneOf": [
    { "$ref": "#/$defs/productPage" },
    { "$ref": "#/$defs/constraintPage" },
    { "$ref": "#/$defs/researchPage" },
    { "$ref": "#/$defs/decisionPage" },
    { "$ref": "#/$defs/problemPage" },
    { "$ref": "#/$defs/featurePage" },
    { "$ref": "#/$defs/actorPage" },
    { "$ref": "#/$defs/rolePage" },
    { "$ref": "#/$defs/journeyPage" },
    { "$ref": "#/$defs/modulePage" },
    { "$ref": "#/$defs/businessRecordPage" },
    { "$ref": "#/$defs/useCasePage" },
    { "$ref": "#/$defs/runbookPage" },
    { "$ref": "#/$defs/exceptionPage" },
    { "$ref": "#/$defs/knownGapPage" },
    { "$ref": "#/$defs/productTopicPage" },
    { "$ref": "#/$defs/permissionListPage" },
    { "$ref": "#/$defs/entryPointListPage" },
    { "$ref": "#/$defs/limitSetPage" },
    { "$ref": "#/$defs/ruleSetPage" },
    { "$ref": "#/$defs/indexPage" },
    { "$ref": "#/$defs/tutorialPage" },
    { "$ref": "#/$defs/howToPage" },
    { "$ref": "#/$defs/referencePage" },
    { "$ref": "#/$defs/commandPage" },
    { "$ref": "#/$defs/configurationPage" },
    { "$ref": "#/$defs/glossaryPage" },
    { "$ref": "#/$defs/scenarioCastPage" }
  ],
  "$defs": {
    "productId": {
      "type": "string",
      "pattern": "^product/[a-z0-9][a-z0-9-]*$"
    },
    "constraintId": {
      "type": "string",
      "pattern": "^constraint/[a-z0-9][a-z0-9-]*$"
    },
    "researchId": {
      "type": "string",
      "pattern": "^research/[a-z0-9][a-z0-9-]*$"
    },
    "decisionId": {
      "type": "string",
      "pattern": "^decision/[0-9]+-[a-z0-9][a-z0-9-]*$"
    },
    "requirementId": {
      "type": "string",
      "pattern": "^requirement/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "problemId": {
      "type": "string",
      "pattern": "^problem/[a-z0-9][a-z0-9-]*$"
    },
    "featureId": {
      "type": "string",
      "pattern": "^feature/[a-z0-9][a-z0-9-]*$"
    },
    "actorId": {
      "type": "string",
      "pattern": "^actor/[a-z0-9][a-z0-9-]*$"
    },
    "roleId": {
      "type": "string",
      "pattern": "^role/[a-z0-9][a-z0-9-]*$"
    },
    "permissionId": {
      "type": "string",
      "pattern": "^permission/[a-z0-9][a-z0-9-]*$"
    },
    "journeyId": {
      "type": "string",
      "pattern": "^journey/[a-z0-9][a-z0-9-]*$"
    },
    "moduleId": {
      "type": "string",
      "pattern": "^module/[a-z0-9][a-z0-9-]*$"
    },
    "businessRecordId": {
      "type": "string",
      "pattern": "^business-record/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "ruleId": {
      "type": "string",
      "pattern": "^rule/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "useCaseId": {
      "type": "string",
      "pattern": "^use-case/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "resultId": {
      "type": "string",
      "pattern": "^result/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "caseId": {
      "type": "string",
      "pattern": "^case/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "eventId": {
      "type": "string",
      "pattern": "^event/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "entryPointId": {
      "type": "string",
      "pattern": "^entry-point/[a-z0-9][a-z0-9-]*$"
    },
    "limitId": {
      "type": "string",
      "pattern": "^limit/[a-z0-9][a-z0-9-]*$"
    },
    "runbookId": {
      "type": "string",
      "pattern": "^runbook/[a-z0-9][a-z0-9-]*$"
    },
    "projectStandardId": {
      "type": "string",
      "pattern": "^standard/[a-z0-9][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "exceptionId": {
      "type": "string",
      "pattern": "^exception/[a-z0-9][a-z0-9-]*$"
    },
    "knownGapId": {
      "type": "string",
      "pattern": "^known-gap/[a-z0-9][a-z0-9-]*$"
    },
    "termId": {
      "type": "string",
      "pattern": "^term/[a-z0-9][a-z0-9-]*$"
    },
    "failureCode": {
      "type": "string",
      "pattern": "^failure/[a-z0-9][a-z0-9-]*\\.[a-zA-Z0-9][a-zA-Z0-9_-]*$"
    },
    "standardsProvisionId": {
      "type": "string",
      "pattern": "^standards/(rule|convention)/[a-z][a-z0-9-]*\\.[a-z0-9][a-z0-9-]*$"
    },
    "genericRecordId": {
      "type": "string",
      "pattern": "^[a-z][a-z-]+/[a-z0-9][a-z0-9._-]*$"
    },
    "ownerName": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": ["draft", "approved", "retired"]
    },
    "isoDate": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "termIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/termId" }
    },
    "actorIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/actorId" }
    },
    "permissionIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/permissionId" }
    },
    "moduleIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/moduleId" }
    },
    "eventIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/eventId" }
    },
    "entryPointIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/entryPointId" }
    },
    "problemIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/problemId" }
    },
    "requirementIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/requirementId" }
    },
    "genericIdArray": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/genericRecordId" }
    },
    "basedOnArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/constraintId" },
          { "$ref": "#/$defs/researchId" }
        ]
      }
    },
    "decidesArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/requirementId" },
          { "$ref": "#/$defs/featureId" },
          { "$ref": "#/$defs/ruleId" },
          { "$ref": "#/$defs/constraintId" },
          { "$ref": "#/$defs/permissionId" },
          { "$ref": "#/$defs/roleId" },
          { "$ref": "#/$defs/actorId" },
          { "$ref": "#/$defs/exceptionId" },
          { "$ref": "#/$defs/projectStandardId" },
          { "$ref": "#/$defs/entryPointId" },
          { "$ref": "#/$defs/limitId" },
          { "$ref": "#/$defs/decisionId" }
        ]
      }
    },
    "governsArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "anyOf": [
          { "$ref": "#/$defs/businessRecordId" },
          { "$ref": "#/$defs/useCaseId" }
        ]
      }
    },
    "refusalValue": {
      "anyOf": [
        { "$ref": "#/$defs/resultId" },
        { "$ref": "#/$defs/failureCode" }
      ]
    },
    "limitValue": {
      "anyOf": [{ "type": "string" }, { "type": "number" }]
    },
    "standardRef": {
      "anyOf": [
        { "$ref": "#/$defs/standardsProvisionId" },
        { "$ref": "#/$defs/projectStandardId" }
      ]
    },
    "holdItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope"],
      "properties": {
        "role": { "$ref": "#/$defs/roleId" },
        "scope": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "journeyStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["useCase"],
      "properties": {
        "useCase": { "$ref": "#/$defs/useCaseId" },
        "actor": { "$ref": "#/$defs/actorId" },
        "requires": { "$ref": "#/$defs/genericIdArray" }
      }
    },
    "researchSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url"],
      "properties": {
        "url": { "$ref": "#/$defs/nonEmptyString" },
        "read": { "$ref": "#/$defs/isoDate" }
      }
    },
    "promiseValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "effectiveFrom"],
      "properties": {
        "value": { "$ref": "#/$defs/nonEmptyString" },
        "effectiveFrom": { "$ref": "#/$defs/isoDate" }
      }
    },
    "useCaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "meaning"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "meaning": { "$ref": "#/$defs/nonEmptyString" },
        "rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      }
    },
    "recordsArray": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/requirementEntry" },
          { "$ref": "#/$defs/permissionEntry" },
          { "$ref": "#/$defs/ruleEntry" },
          { "$ref": "#/$defs/resultEntry" },
          { "$ref": "#/$defs/caseEntry" },
          { "$ref": "#/$defs/eventEntry" },
          { "$ref": "#/$defs/entryPointEntry" },
          { "$ref": "#/$defs/limitEntry" },
          { "$ref": "#/$defs/standardEntry" }
        ]
      }
    },
    "requirementEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "kind", "statement"],
      "properties": {
        "type": { "const": "requirement" },
        "id": { "$ref": "#/$defs/requirementId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "kind": { "enum": ["promise", "behaviour", "quality", "target", "practice"] },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "values": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/promiseValue" }
        },
        "measure": { "$ref": "#/$defs/nonEmptyString" },
        "by": { "$ref": "#/$defs/nonEmptyString" },
        "deliveredBy": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^feature/[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "basedOn": { "$ref": "#/$defs/basedOnArray" }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": { "kind": { "const": "target" } }
          },
          "then": { "required": ["measure", "by"] }
        },
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "permissionEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "code", "codeType", "meaning"],
      "properties": {
        "type": { "const": "permission" },
        "id": { "$ref": "#/$defs/permissionId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "codeType": {
          "type": "string",
          "pattern": "^[A-Z][A-Za-z0-9]*$"
        },
        "meaning": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "ruleEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "kind", "enforcedBy", "statement"],
      "properties": {
        "type": { "const": "rule" },
        "id": { "$ref": "#/$defs/ruleId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "kind": { "enum": ["always-true", "checked-before", "across-records"] },
        "enforcedBy": { "enum": ["validator", "aggregate", "store", "guard", "reaction"] },
        "statement": { "$ref": "#/$defs/nonEmptyString" },
        "governs": { "$ref": "#/$defs/governsArray" },
        "refusal": { "$ref": "#/$defs/refusalValue" },
        "basedOn": { "$ref": "#/$defs/basedOnArray" },
        "fulfils": { "$ref": "#/$defs/requirementIdArray" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "resultEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "outcome", "meaning"],
      "properties": {
        "type": { "const": "result" },
        "id": { "$ref": "#/$defs/resultId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "type": "integer" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "outcome": { "enum": ["success", "refusal"] },
        "code": { "$ref": "#/$defs/failureCode" },
        "meaning": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "required": ["outcome"],
            "properties": { "outcome": { "const": "refusal" } }
          },
          "then": { "required": ["code"] }
        }
      ]
    },
    "caseEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "situation", "action", "result", "expect"],
      "properties": {
        "type": { "const": "case" },
        "id": { "$ref": "#/$defs/caseId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "situation": { "$ref": "#/$defs/nonEmptyString" },
        "action": { "$ref": "#/$defs/nonEmptyString" },
        "result": { "$ref": "#/$defs/resultId" },
        "expect": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "eventEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "meaning", "carries"],
      "properties": {
        "type": { "const": "event" },
        "id": { "$ref": "#/$defs/eventId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "meaning": { "$ref": "#/$defs/nonEmptyString" },
        "carries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "entryPointEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "kind"],
      "properties": {
        "type": { "const": "entry-point" },
        "id": { "$ref": "#/$defs/entryPointId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "kind": { "enum": ["web-app", "public-api", "cli", "mcp-server", "site", "reaction", "job"] },
        "path": { "$ref": "#/$defs/nonEmptyString" },
        "offers": { "$ref": "#/$defs/permissionIdArray" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "limitEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "bound", "value"],
      "properties": {
        "type": { "const": "limit" },
        "id": { "$ref": "#/$defs/limitId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "bound": { "$ref": "#/$defs/nonEmptyString" },
        "value": { "$ref": "#/$defs/limitValue" },
        "runbook": { "$ref": "#/$defs/runbookId" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "standardEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title"],
      "properties": {
        "type": { "const": "standard" },
        "id": { "$ref": "#/$defs/projectStandardId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "statement": { "$ref": "#/$defs/nonEmptyString" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "productPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "owner", "status", "boundary", "neverDoes", "audience"],
      "properties": {
        "type": { "const": "product" },
        "id": { "$ref": "#/$defs/productId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
        "terms": { "$ref": "#/$defs/termIdArray" },
        "records": { "$ref": "#/$defs/recordsArray" },
        "boundary": { "$ref": "#/$defs/nonEmptyString" },
        "neverDoes": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmptyString" }
        },
        "audience": { "$ref": "#/$defs/actorIdArray" }
      },
      "allOf": [
        {
          "if": {
            "required": ["status"],
            "properties": { "status": { "const": "draft" } }
          },
          "then": { "required": ["decider", "decideBy"] }
        }
      ]
    },
    "constraintPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "title", "owner", "status", "source", "applies", "appliesBecause"],
      "properties": {
        "type": { "const": "constraint" },
        "id": { "$ref": "#/$defs/constraintId" },
        "title": { "$ref": "#/$defs/nonEmptyString" },
        "owner": { "$ref": "#/$defs/ownerName" },
        "status": { "$ref": "#/$defs/status" },
        "decider": { "$ref": "#/$defs/ownerName" },
        "decideBy": { "$ref": "#/$defs/isoDate" },
