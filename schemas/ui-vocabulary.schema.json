{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/ui-vocabulary.schema.json",
  "title": "Litenova Frontend UI Vocabulary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "frontend",
    "profile",
    "baseline",
    "tokens",
    "states",
    "shells",
    "patterns",
    "components",
    "forks",
    "specialists",
    "runtimeStyles",
    "evidence"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "frontend": { "$ref": "#/$defs/identifier" },
    "profile": { "$ref": "#/$defs/profile" },
    "baseline": { "$ref": "#/$defs/baseline" },
    "tokens": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "states": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/state" }
    },
    "shells": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/shell" }
    },
    "patterns": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pattern" }
    },
    "components": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/component" }
    },
    "forks": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/fork" }
    },
    "specialists": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/specialist" }
    },
    "runtimeStyles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/runtimeStyle" }
    },
    "evidence": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/evidence" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*(?:/[a-z][a-z0-9-]*)*$"
    },
    "profile": {
      "type": "string",
      "enum": ["public-light", "application-balanced", "admin-dense"]
    },
    "status": {
      "type": "string",
      "enum": ["baseline", "extended", "forked", "specialist"]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "styling",
        "base",
        "style",
        "presetCode",
        "presetFingerprint",
        "cssVariables",
        "baseColor",
        "theme",
        "chartColor",
        "font",
        "fontHeading",
        "icons",
        "radius",
        "menuAccent",
        "menuColor",
        "componentsStyle"
      ],
      "properties": {
        "system": { "const": "shadcn/ui" },
        "styling": { "const": "tailwindcss-v4" },
        "base": { "enum": ["base-ui", "radix-ui"] },
        "style": { "type": "string", "minLength": 1 },
        "presetCode": { "type": "string", "minLength": 1 },
        "presetFingerprint": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "cssVariables": { "const": true },
        "baseColor": { "type": "string", "minLength": 1 },
        "theme": { "type": "string", "minLength": 1 },
        "chartColor": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "minLength": 1 },
        "fontHeading": { "type": "string", "minLength": 1 },
        "icons": { "const": "lucide" },
        "radius": { "type": "string", "minLength": 1 },
        "menuAccent": { "enum": ["subtle", "bold"] },
        "menuColor": { "enum": ["default", "inverted", "default-translucent", "inverted-translucent"] },
        "componentsStyle": { "type": "string", "minLength": 1 }
      }
    },
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type", "light", "dark"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "type": {
          "type": "string",
          "enum": ["color", "length", "font", "shadow", "motion"]
        },
        "light": { "type": "string", "minLength": 1 },
        "dark": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredEvidence"],
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "loading",
            "empty",
            "error",
            "forbidden",
            "not-found",
            "pending",
            "disabled",
            "offline",
            "ready",
            "validation-error",
            "saving",
            "saved"
          ]
        },
        "requiredEvidence": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "shell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "regions", "responsiveModes"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "regions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "responsiveModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["compact", "medium", "wide"] }
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "components", "states", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "status", "variants", "states", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "source": { "type": "string", "minLength": 1 },
        "status": { "$ref": "#/$defs/status" },
        "variants": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "fork": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "status", "reason", "scope", "owner", "reviewWhen", "evidence"],
      "properties": {
        "component": { "type": "string", "minLength": 1 },
        "status": { "const": "forked" },
        "reason": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "owner": { "type": "string", "minLength": 1 },
        "reviewWhen": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "specialist": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "package", "reason", "scope", "fallback", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "package": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 },
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "fallback": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "runtimeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "properties", "reason", "evidence"],
      "properties": {
        "scope": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "properties": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^--[a-z][a-z0-9-]*$" }
        },
        "reason": { "type": "string", "minLength": 1 },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "environment", "result", "reviewer", "date"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:AC|E2E|UI)-[A-Z0-9-]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["component", "browser", "accessibility", "visual", "manual"]
        },
        "environment": { "type": "string", "minLength": 1 },
        "result": { "enum": ["pass", "fail", "waived"] },
        "reviewer": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    }
  }
}
