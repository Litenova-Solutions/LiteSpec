{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Litenova-Solutions/Engineering-Standards/schemas/acceptance-criteria.schema.json",
  "title": "Litenova Page Acceptance Criteria",
  "description": "The acceptance record beside one page. Every AC identifier a page sidecar names has one entry here and one runnable file the entry points at.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "page", "criteria"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "$comment": "Each release pins one exact shape. A consumer adopting a later release absorbs every difference at that moment, so no minor-compatible range exists between two releases. See CORE.AUTHORING.SNAPSHOT.003 and CORE.AUTHORING.SNAPSHOT.004.",
      "const": 1
    },
    "page": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9-]*$"
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/criterion" }
    }
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proves", "precondition", "steps", "assertions", "spec"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-[A-Z0-9-]+$"
        },
        "proves": { "type": "string", "minLength": 1 },
        "precondition": { "type": "string", "minLength": 1 },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "spec": {
          "$comment": "A path relative to this record, so the file that proves the criterion sits beside the page it proves.",
          "type": "string",
          "pattern": "^AC-[A-Z0-9-]+\\.spec\\.ts$"
        }
      }
    }
  }
}
