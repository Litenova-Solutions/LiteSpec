{
  "$schema": "https://litespec.dev/3.0.0/schemas/litespec-project.schema.json",
  "project": {
    "name": "__PROJECT__"
  },
  "size": "small",
  "shape": "server",
  "stacks": [
    "dotnet",
    "react"
  ],
  "reviewedLiteSpecVersion": "3.0.0",
  "optionalTypes": [],
  "constraints": {
    "answered": true
  },
  "owners": [
    "__OWNER__"
  ],
  "review": {
    "vetoWindowDays": 7,
    "securityReviewer": "__OWNER__"
  },
  "adoption": {
    "transcriptionEndsWith": "decision/<name>"
  },
  "paths": {
    "docs": "docs",
    "behaviorDocs": "docs/behavior",
    "uiDocs": "docs/ui",
    "unstructuredDocs": [],
    "testRoots": [
      "apps/api/tests"
    ],
    "uiPackage": {
      "name": "@__PROJECT__/ui",
      "path": "packages/ui",
      "componentsJson": "packages/ui/components.json",
      "primitives": "packages/ui/src/components",
      "tokens": "packages/ui/src/styles/tokens.css",
      "sourceLock": "packages/ui/ui-source-lock.json",
      "designContract": "packages/ui/DESIGN.md",
      "publicExports": [
        "@__PROJECT__/ui/floorplans"
      ]
    },
    "uiPatterns": "docs/ui/pattern-catalog.json",
    "frontends": [
      {
        "name": "web",
        "path": "apps/web",
        "platform": "react",
        "ui": {
          "profile": "application-balanced",
          "globalCss": "apps/web/src/styles.css"
        }
      }
    ],
    "sites": [],
    "glossaryScan": []
  },
  "stackConfig": {
    "dotnet": {
      "apiSolution": "apps/api/__PROJECT__.slnx"
    }
  },
  "selectedExtensions": []
}
