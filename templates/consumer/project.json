{
  "$schema": "https://litespec.dev/4.1.0/schemas/litespec-project.schema.json",
  "project": {
    "name": "__PROJECT__"
  },
  "size": "small",
  "shape": "server",
  "stacks": [
    "dotnet",
    "react"
  ],
  "conformance": "full",
  "reviewedLiteSpecVersion": "4.1.0",
  "screenshots": {
    "galleries": [
      "apps/web/test-results/gallery"
    ],
    "pattern": "{route}--{theme}--{width}.png"
  },
  "paths": {
    "docs": ".litespec",
    "behaviorDocs": ".litespec/behavior",
    "unstructuredDocs": [],
    "testRoots": [
      "apps/api/tests"
    ],
    "uiPackage": {
      "name": "@__PROJECT__/ui",
      "path": "packages/ui",
      "componentsJson": "packages/ui/components.json",
      "primitives": "packages/ui/src/components",
      "tokens": "packages/ui/src/styles/tokens.css",
      "sourceLock": "packages/ui/ui-source-lock.json",
      "designContract": "packages/ui/DESIGN.md",
      "publicExports": [
        "@__PROJECT__/ui/floorplans"
      ]
    },
    "uiPatterns": ".litespec/implementation/patterns/catalog.json",
    "frontends": [
      {
        "name": "web",
        "path": "apps/web",
        "platform": "react",
        "ui": {
          "profile": "application-balanced",
          "globalCss": "apps/web/src/styles.css"
        }
      }
    ],
    "sites": []
  },
  "stackConfig": {
    "dotnet": {
      "modules": "apps/api/src/__PROJECT__.Modules",
      "sharedKernel": "apps/api/src/__PROJECT__.SharedKernel",
      "apiSolution": "apps/api/__PROJECT__.slnx"
    }
  },
  "selectedExtensions": []
}
