{
  "$schema": "./standards/schemas/standards-project.schema.json",
  "project": {
    "name": "<project>"
  },
  "size": "<small|large>",
  "stacks": ["dotnet", "<react|svelte|blazor-web>"],
  "reviewedStandardsVersion": "2.0.0",
  "optionalTypes": ["<constraint|research|limit|runbook>"],
  "constraints": {
    "answered": false
  },
  "owners": ["<owner>"],
  "paths": {
    "apiSolution": "<api-solution>",
    "docs": "docs",
    "domainDocs": "docs/domain",
    "uiDocs": "docs/ui",
    "unstructuredDocs": [],
    "testRoots": [],
    "languageScan": [],
    "uiPackage": {
      "name": "@<project>/ui",
      "path": "packages/ui",
      "componentsJson": "packages/ui/components.json",
      "primitives": "packages/ui/src/components",
      "tokens": "packages/ui/src/styles/tokens.css",
      "sourceLock": "packages/ui/ui-source-lock.json",
      "designContract": "packages/ui/DESIGN.md",
      "publicExports": ["@<project>/ui/floorplans", "@<project>/ui/display", "@<project>/ui/forms"]
    },
    "uiPatterns": "docs/ui/pattern-catalog.json",
    "frontends": [
      {
        "name": "<frontend>",
        "path": "apps/<frontend>",
        "platform": "<react|svelte|blazor-web>",
        "ui": {
          "profile": "application-balanced",
          "globalCss": "apps/<frontend>/src/<styles>.css"
        }
      }
    ],
    "sites": []
  },
  "extensions": [
    {
      "id": "<extension>",
      "criterion": "<Why this extension applies>",
      "reviewBy": "<YYYY-MM-DD>"
    }
  ]
}
