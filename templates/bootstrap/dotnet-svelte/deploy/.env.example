# Example environment for deploy/compose.yaml. Copy to deploy/.env to change
# a value; every entry below already has a working default in compose.yaml,
# so a plain `docker compose -f deploy/compose.yaml up --build` needs no file.
# Every value here is synthetic and local-only.

# Host port publishing the API container's port 8080.
API_PORT=5005
# Host port publishing the web container's port 3000.
WEB_PORT=3000
# PostgreSQL password shared by the postgres service and the API connection string.
POSTGRES_PASSWORD=__SCOPE__-dev
