<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>LiteSpec</RootNamespace>
        <AssemblyName>litespec-maintain</AssemblyName>
        <IsPackable>false</IsPackable>
        <Description>The LiteSpec maintainer tool: the authoring checks and the provision index. It runs in the LiteSpec repository and is never packed for consumers.</Description>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../model/src/LiteSpec.Model.Roslyn/LiteSpec.Model.Roslyn.csproj" />
        <ProjectReference Include="../../../model/src/LiteSpec.Shared/LiteSpec.Shared.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LiteSpec.Maintain.Tests" />
    </ItemGroup>

</Project>
