<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <RootNamespace>LiteSpec</RootNamespace>
        <AssemblyName>litespec</AssemblyName>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>litespec</ToolCommandName>
        <PackageId>LiteSpec.Cli</PackageId>
        <!-- The package version is the release version: keep it equal to version in litespec.manifest.yaml. -->
        <Version>6.0.0</Version>
        <Description>The LiteSpec command line: consumer and UI validation, the project model, and the project book. The package carries the LiteSpec release it checks against.</Description>
        <Authors>Litenova Solutions</Authors>
        <PackageTags>litespec;specification;architecture;dotnet-tool;ddd</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://litespec.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Litenova-Solutions/LiteSpec</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>icon.png</PackageIcon>
    </PropertyGroup>

    <!--
        The tool compiles ahead of time into one native executable per platform, which needs no
        .NET runtime. The trim, AOT and single-file analyzers run in every build, so a call that
        needs runtime code, such as reflection-based JSON, fails the build at once. PublishAot
        itself applies only to a pack or publish for a platform and to the top-level package, so
        a plain build restores no compiler and the lock file does not change with the SDK or the
        machine that builds it.
        The CLI compares text ordinally and formats with the invariant culture, so it carries no
        ICU, and it hashes with its own SHA-256 rather than OpenSSL, so the Linux binary needs
        only the C library.
        dotnet pack -p:TopLevelToolPackage=true makes the LiteSpec.Cli package that points to one
        package per platform; dotnet pack -r <rid> makes each platform's native package on a
        machine of that operating system; and dotnet pack -r any -p:PublishAot=false makes the
        framework-dependent package that serves every other platform.
        IL3000: Roslyn's command-line compiler driver, CommonCompiler.GetAssemblyLocation, reads
        Assembly.Location. The CLI only parses syntax trees and never runs that driver, and it
        finds its own folder through AppContext.BaseDirectory.
    -->
    <PropertyGroup>
        <EnableAotAnalyzer>true</EnableAotAnalyzer>
        <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
        <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
        <InvariantGlobalization>true</InvariantGlobalization>
        <ToolPackageRuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;linux-musl-x64;linux-musl-arm64;osx-x64;osx-arm64;any</ToolPackageRuntimeIdentifiers>
        <NoWarn>$(NoWarn);IL3000</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' or '$(TopLevelToolPackage)' == 'true'">
        <PublishAot>true</PublishAot>
    </PropertyGroup>

    <!-- A platform build ships the executable and its release, not the debug symbols or the XML documentation. -->
    <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
        <PublishDocumentationFile>false</PublishDocumentationFile>
        <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
        <!-- The referenced libraries are compiled into the executable, so their own symbol files describe nothing that ships. -->
        <AllowedReferenceRelatedFileExtensions>.dll.config</AllowedReferenceRelatedFileExtensions>
    </PropertyGroup>

    <ItemGroup>
        <!-- The NuGet listing shows this page; it is written for a consumer installing the tool. -->
        <None Include="README.md" Pack="true" PackagePath="README.md" />
        <None Include="../../../../assets/logo/png/icon-128.png" Pack="true" PackagePath="icon.png" Visible="false" />
        <!-- Every third-party component the package carries, with its license. -->
        <None Include="../../../../THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="THIRD-PARTY-NOTICES.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- The TypeScript frontend reader, bundled by the build script in apps/cli/fe-reader, copied beside the tool when it has been built. -->
        <Content Include="../../fe-reader/dist/litespec-fe-reader.mjs" Link="litespec-fe-reader.mjs" Pack="false" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="Exists('../../fe-reader/dist/litespec-fe-reader.mjs')" />
    </ItemGroup>

    <!-- A package without the reader would report every frontend as unreadable, and one without the book client writes no book, so neither is packed. -->
    <Target Name="RequireFrontendReader" BeforeTargets="GenerateNuspec">
        <Error Condition="!Exists('../../fe-reader/dist/litespec-fe-reader.mjs')" Text="The frontend reader bundle is missing; build it in apps/cli/fe-reader before packing the tool." />
        <Error Condition="!Exists('../../book/dist/book.js')" Text="The book client is missing; build it in apps/cli/book before packing the tool." />
    </Target>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../../../model/src/LiteSpec.Model/LiteSpec.Model.csproj" />
        <ProjectReference Include="../../../model/src/LiteSpec.Model.Roslyn/LiteSpec.Model.Roslyn.csproj" />
        <ProjectReference Include="../../../model/src/LiteSpec.CommandLine/LiteSpec.CommandLine.csproj" />
        <ProjectReference Include="../../../model/src/LiteSpec.Standards/LiteSpec.Standards.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LiteSpec.Cli.Tests" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="Book/Assets/book-shell.html" LogicalName="LiteSpec.Book.Assets.%(Filename)%(Extension)" />
        <!-- The book client, built by Vite in apps/cli/book into one classic script and one stylesheet. -->
        <EmbeddedResource Include="../../book/dist/book.js;../../book/dist/book.css" LogicalName="LiteSpec.Book.Assets.%(Filename)%(Extension)" Condition="Exists('../../book/dist/book.js')" />
    </ItemGroup>

    <!--
        The tool carries its whole release beside its binary: the manifest, schemas, docs and
        templates land in the publish folder through these links, so dotnet pack puts them in
        the tool's folder. They stay out of the build output: in a repository checkout
        LiteSpecHome walks up to the repository root instead.
    -->
    <ItemGroup>
        <Content Include="../../../../litespec.manifest.yaml" Link="litespec.manifest.yaml" CopyToPublishDirectory="PreserveNewest" Pack="false" />
        <Content Include="../../../../schemas/**" Link="schemas/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Pack="false" />
        <Content Include="../../../../docs/**" Link="docs/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Pack="false" />
        <Content Include="../../../../templates/**" Link="templates/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" Pack="false" />
    </ItemGroup>

</Project>
