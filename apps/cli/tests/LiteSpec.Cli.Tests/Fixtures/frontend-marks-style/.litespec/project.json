      "apps/api/tests"
    ],
    "frontends": [
      {
        "name": "web",
        "path": "apps/web",
        "platform": "svelte"
      }
    ]
  },
  "stackConfig": {
    "dotnet": {
      "modules": "apps/api/src/Library.Application",
      "domain": "apps/api/src/Library.Domain",
      "webapi": "apps/api/src/Library.WebApi",
      "infrastructure": "apps/api/src/Library.Infrastructure"
    }
  }
}
