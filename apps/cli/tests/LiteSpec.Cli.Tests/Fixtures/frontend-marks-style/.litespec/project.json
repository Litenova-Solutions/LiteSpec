{
  "project": {
    "name": "Frontend Marks Fixture"
  },
  "size": "small",
  "shape": "server",
  "stacks": [
    "dotnet",
    "svelte"
  ],
  "marks": "attribute",
  "conformance": "full",
  "reviewedLiteSpecVersion": "4.0.0",
