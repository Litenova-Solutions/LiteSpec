{
  "project": {
    "name": "Fixture Library"
  },
  "size": "large",
  "shape": "server",
  "stacks": [
    "dotnet",
    "svelte"
  ],
  "conformance": "full",
  "reviewedLiteSpecVersion": "4.0.0",
  "paths": {
    "docs": ".litespec",
    "behaviorDocs": ".litespec/behavior",
    "glossary": ".litespec/glossary.yaml",
    "testRoots": [
      "apps/api/tests"
    ],
    "frontends": [
      {
        "name": "catalog",
        "path": "apps/catalog",
        "platform": "svelte",
        "ui": {
          "profile": "application-balanced",
          "globalCss": "apps/catalog/src/styles.css"
        }
      }
    ],
    "apiClient": "packages/api",
    "uiPackage": {
      "name": "@fixture/ui",
      "path": "packages/ui",
      "componentsJson": "packages/ui/components.json",
      "primitives": "packages/ui/src/components",
      "tokens": "packages/ui/src/styles/tokens.css",
      "sourceLock": "packages/ui/ui-source-lock.json",
      "designContract": "packages/ui/DESIGN.md",
      "publicExports": [
        "@fixture/ui/floorplans"
      ]
    },
    "records": {}
  },
  "stackConfig": {
    "dotnet": {
      "modules": "apps/api/src/Library.Application",
      "domain": "apps/api/src/Library.Domain",
      "webapi": "apps/api/src/Library.WebApi"
    }
  },
  "selectedExtensions": []
}
