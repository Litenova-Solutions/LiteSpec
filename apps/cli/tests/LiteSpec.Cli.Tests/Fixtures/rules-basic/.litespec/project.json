{
  "$schema": "https://litespec.dev/4.0.0/schemas/litespec-project.schema.json",
  "project": {
    "name": "Demo"
  },
  "size": "large",
  "shape": "server",
  "stacks": [
    "dotnet",
    "svelte"
  ],
  "reviewedLiteSpecVersion": "4.0.0",
  "paths": {
    "docs": ".litespec",
    "behaviorDocs": ".litespec/behavior",
    "glossary": ".litespec/glossary.yaml",
    "testRoots": [
      "apps/api/tests"
    ],
    "frontends": [
      {
        "name": "web",
        "path": "apps/web",
        "platform": "svelte",
        "entryPoint": "entry-point/billing-app"
      }
    ]
  },
  "stackConfig": {
    "dotnet": {
      "application": "apps/api/src/Demo"
    }
  },
  "selectedExtensions": []
}
