<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!--
            The code both command lines share: option parsing, JSON, the release
            locator, the page reader, the provision index builder, the stack layout,
            the prose helpers, the schema evaluator, and the pattern page parser.
            Both tools reference it instead of copying it.
        -->
        <RootNamespace>LiteSpec</RootNamespace>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Markdig" />
    </ItemGroup>

</Project>
