<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- The shared mark and kind reader loads into the CLI, the analyzers and the source generator, so it targets netstandard2.0. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>LiteSpec.Model.Roslyn</RootNamespace>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <!-- Pinned to the compiler the analyzers support, and kept private to this library. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../LiteSpec.Model.Core/LiteSpec.Model.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LiteSpec.Model.Tests" />
    </ItemGroup>

</Project>
