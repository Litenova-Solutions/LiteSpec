---
// The shared layout: head, the theme set before first paint, the framed column
// with the header and footer, and the copy-button behavior. Every page is static
// and complete without JavaScript; scripts only add the theme, copying, search
// and the "On this page" tracking.
import "../styles/site.css";
import Icon from "../components/Icon.astro";
import Mark from "../components/Mark.astro";
import Search from "../components/Search.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";
import { version } from "../lib/spec";
import { absoluteUrl, metaDescription, organization, socialImage } from "../lib/seo";

interface Props {
  title: string;
  description: string;
  /** The raw Markdown URL of the page, when the page has one. */
  rawUrl?: string;
  /** The header section this page belongs to. */
  active?: "docs" | "patterns" | "agents";
  /** Keeps the page out of search indexes, such as the 404 page. */
  noindex?: boolean;
  /** "article" for a docs page, "website" otherwise. */
  ogType?: "website" | "article";
  /** Schema.org objects for this page, written as one JSON-LD graph. */
  jsonLd?: Record<string, unknown>[];
}

const { title, rawUrl, active, noindex = false, ogType = "website", jsonLd = [] } = Astro.props;
const description = metaDescription(Astro.props.description);
const canonical = absoluteUrl(Astro.url.pathname);
const graph = JSON.stringify({ "@context": "https://schema.org", "@graph": [organization, ...jsonLd] });
const github = "https://github.com/Litenova-Solutions/LiteSpec";
const links = [
  { href: `/${version}/learn/`, label: "Docs", key: "docs" },
  { href: `/${version}/frontend/patterns/`, label: "Patterns", key: "patterns" },
  { href: `/${version}/select/`, label: "Use with agents", key: "agents" },
] as const;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large, max-snippet:-1"} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#151217" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="LiteSpec" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    {rawUrl && <link rel="alternate" type="text/markdown" href={rawUrl} />}
    <link rel="preload" href="/fonts/geist-latin.woff2" as="font" type="font/woff2" crossorigin />
    <script type="application/ld+json" set:html={graph} />
    <script is:inline>
      try {
        var theme = window.localStorage.getItem("litespec-theme");
        if (theme === "light" || theme === "dark") document.documentElement.setAttribute("data-theme", theme);
      } catch (err) { /* a blocked store keeps the system theme */ }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to main content</a>
    <div class="frame">
      <header class="site-top">
        <div class="wrap">
          <a class="logo" href="/" aria-label="LiteSpec home">
            <Mark />LiteSpec
          </a>
          <nav class="site-nav" aria-label="Site">
            {links.map((link) => (
              <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>
            ))}
          </nav>
          <div class="site-end">
            <Search />
            <a class="btn btn-ghost btn-icon" href={github} aria-label="LiteSpec on GitHub"><Icon name="github" /></a>
            <ThemeSwitcher />
            <details class="site-menu">
              <summary class="btn btn-ghost btn-icon" aria-label="Menu"><Icon name="menu" /></summary>
              <nav class="site-menu-panel" aria-label="Site">
                {links.map((link) => (
                  <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>
                ))}
              </nav>
            </details>
          </div>
        </div>
      </header>
      <main id="content" class="frame-main">
        <slot />
      </main>
      <footer class="site-foot">
        <div class="wrap">
          <span class="brand"><Mark size={16} />LiteSpec {version}</span>
          <span>MIT license</span>
          <span>By <a href="https://litenova.solutions">Litenova Solutions</a></span>
          <span class="spacer"></span>
          <a href="/llms.txt">llms.txt</a>
          <a href={github}>GitHub</a>
          <a href={`${github}/blob/main/CHANGELOG.md`}>Changelog</a>
        </div>
      </footer>
    </div>
    <script is:inline>
      (function () {
        // Any element with data-copy or data-copy-url copies its text. Its first .copy-label child,
        // or the element itself when it has none, shows "Copied" for a moment.
        function flash(button) {
          var label = button.querySelector(".copy-label") || (button.children.length === 0 ? button : null);
          button.setAttribute("data-copied", "");
          if (label) {
            var text = label.textContent;
            label.textContent = "Copied";
            window.setTimeout(function () { label.textContent = text; button.removeAttribute("data-copied"); }, 1500);
          } else {
            window.setTimeout(function () { button.removeAttribute("data-copied"); }, 1500);
          }
        }
        // data-copy holds the text; data-copy-url names a file whose text is fetched and copied,
        // so a long text such as a whole page stays out of the HTML.
        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;
          var button = target.closest("[data-copy], [data-copy-url]");
          if (!button) return;
          var url = button.getAttribute("data-copy-url");
          if (url) {
            fetch(url).then(function (response) { return response.ok ? response.text() : Promise.reject(); })
              .then(function (text) { return navigator.clipboard.writeText(text); })
              .then(function () { flash(button); }, function () { window.location.href = url; });
            return;
          }
          var text = button.getAttribute("data-copy") || "";
          if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () { flash(button); }, function () { /* the text stays visible */ });
            return;
          }
          try {
            var area = document.createElement("textarea");
            area.value = text;
            document.body.appendChild(area);
            area.select();
            document.execCommand("copy");
            document.body.removeChild(area);
            flash(button);
          } catch (err) { /* the text stays visible */ }
        });
      })();
    </script>
  </body>
</html>
