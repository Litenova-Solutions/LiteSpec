---
/* The project selection page: /[version]/select/. Static HTML with defaults,
   plus the SelectForm island for live updates. */
import fs from "node:fs";
import { breadcrumbs } from "../../../lib/seo";
import path from "node:path";
import Base from "../../../layouts/Base.astro";
import SelectForm from "../../../components/SelectForm.astro";
import Icon from "../../../components/Icon.astro";
import "../../../styles/select.css";
import {
  root,
  version,
  manifest,
  selections,
  selectionKey,
  selectionIndexUrl,
  layerUrl,
  backendStacks,
  frontendStacks,
  extensionStack,
  pageByFile,
  pageUrl,
} from "../../../lib/spec";

export function getStaticPaths() {
  return [{ params: { version } }];
}

export const prerender = true;

const siteOrigin = "https://litespec.dev";
const shapes = Object.keys(manifest.shapes);

interface PresetFile {
  shape: string;
  stacks: string[];
}

const presets = fs
  .readdirSync(path.join(root, "templates/presets"))
  .filter((file) => file.endsWith(".json"))
  .map((file) => {
    const parsed = JSON.parse(fs.readFileSync(path.join(root, "templates/presets", file), "utf8")) as PresetFile;
    return { name: file.slice(0, -".json".length), shape: parsed.shape, stacks: parsed.stacks };
  })
  .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));

const extensions = Object.entries(manifest.extensions)
  .map(([id, ext]) => ({
    id,
    title: pageByFile(ext.path)?.title ?? id,
    activationScope: ext.activationScope ?? "project",
    stack: extensionStack(id),
    layerUrl: layerUrl(`ext/${id}`),
  }))
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));

const selectionInfos = selections().map((selection) => ({
  shape: selection.shape,
  stacks: selection.stacks,
  key: selectionKey(selection),
  indexUrl: selectionIndexUrl(selection),
}));

function joinList(items: string[]): string {
  if (items.length === 0) return "none";
  if (items.length === 1) return items[0];
  if (items.length === 2) return `${items[0]} and ${items[1]}`;
  return `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
}

function sameMembers(a: string[], b: string[]): boolean {
  return a.length === b.length && a.every((item) => b.includes(item));
}

const defaultSize = "small";
const defaultShape = "server";
const defaultBackend = backendStacks[0] ?? "";
const defaultFrontend = frontendStacks.includes("react") ? "react" : (frontendStacks[0] ?? "");
const defaultStacks = defaultFrontend ? [defaultBackend, defaultFrontend] : [defaultBackend];
const defaultSelection = selectionInfos.find(
  (entry) => entry.shape === defaultShape && sameMembers(entry.stacks, defaultStacks)
);
const initialIndexUrl = siteOrigin + (defaultSelection?.indexUrl ?? selectionIndexUrl({ shape: defaultShape, stacks: defaultStacks, extensions: [] }));

const initialAgents = [
  "## LiteSpec",
  `This project follows LiteSpec ${version}: size ${defaultSize}, shape ${defaultShape}, stacks ${joinList(defaultStacks)}, extensions none.`,
  `Before a task, read ${initialIndexUrl} and fetch only the pages the task touches.`,
  "Selected extensions: none",
  "UI work: the pattern pages listed in that index.",
].join("\n");

// The learn pages in the reading order their index states, each with a
// reading time at 220 words a minute.
const learnIndex = pageByFile("docs/learn/README.md");
const readingOrder = [...(learnIndex?.markdown ?? "").matchAll(/^- \[[^\]]+\]\(([a-z0-9-]+)\.md\): (.+)$/gm)]
  .map((match) => ({ page: pageByFile(`docs/learn/${match[1]}.md`), note: match[2] }))
  .filter((entry) => entry.page !== undefined)
  .map((entry) => ({
    title: entry.page!.title,
    url: pageUrl(entry.page!),
    note: entry.note.replace(/^./, (c) => c.toUpperCase()),
    minutes: Math.max(1, Math.round(entry.page!.markdown.split(/\s+/).length / 220)),
  }));
const readingMinutes = readingOrder.reduce((sum, entry) => sum + entry.minutes, 0);

const starterPrompt = [
  `Read ${siteOrigin}/llms.txt. Pick the selection index that matches this project's shape and stacks,`,
  "then fetch only the pages each task touches.",
].join("\n");

const title = "Use LiteSpec with Your Agent - LiteSpec";
const description =
  "Read how LiteSpec works, give your agent one URL, or answer four questions for a block to commit to your project's AGENTS.md.";
---

<Base title={title} description={description} active="agents" jsonLd={[breadcrumbs([{ name: "LiteSpec", path: "/" }, { name: "Use with agents", path: `/${version}/select/` }])]}>
  <div class="select-page">
    <span class="ver">{version}</span>
    <h1>Use LiteSpec with your agent</h1>
    <p class="select-lead">
      Your agent reads LiteSpec as plain Markdown. This page gives it the address to start from and a short block for
      your project's <code>AGENTS.md</code>, so every session reads the same rules before it writes code.
    </p>
    <ol class="steps">
      <li class="step">
        <span class="step-n" aria-hidden="true">1</span>
        <div class="step-body">
          <div class="step-head">
            <h2>Read how it works</h2>
            <p>
              Read these in order before you hand LiteSpec to an agent: you decide what it may do on its own and review
              what it brings back. About {readingMinutes} minutes in all.
            </p>
          </div>
          <ol class="reading">
            {
              readingOrder.map((entry) => (
                <li>
                  <a href={entry.url}>{entry.title}</a>
                  <span class="badge">{entry.minutes} min</span>
                  <p>{entry.note}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </li>
      <li class="step">
        <span class="step-n" aria-hidden="true">2</span>
        <div class="step-body">
          <div class="step-head">
            <h2>Quick start: give your agent one prompt</h2>
            <p>
              No choices to make. The agent reads the site index, finds the selection that matches your project, and
              fetches the rest itself.
            </p>
          </div>
          <section class="select-output" aria-labelledby="select-prompt-heading">
            <div class="select-output-head">
              <h3 id="select-prompt-heading">Prompt for your agent</h3>
              <button class="btn btn-outline btn-sm" type="button" data-copy={starterPrompt}>
                <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy</span>
              </button>
            </div>
            <pre class="select-output-body"><code>{starterPrompt}</code></pre>
          </section>
        </div>
      </li>
      <SelectForm
        version={version}
        siteOrigin={siteOrigin}
        shapes={shapes}
        backendStacks={backendStacks}
        frontendStacks={frontendStacks}
        extensions={extensions}
        selections={selectionInfos}
        presets={presets}
        defaultSize={defaultSize}
        defaultShape={defaultShape}
        defaultBackend={defaultBackend}
        defaultFrontend={defaultFrontend}
        initialAgents={initialAgents}
      />
    </ol>
  </div>
</Base>
