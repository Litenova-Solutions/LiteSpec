---
/* The project selection page: /[version]/select/. Static HTML with defaults,
   plus the SelectForm island for live updates. */
import fs from "node:fs";
import { breadcrumbs, pageTitle, webPage } from "../../../lib/seo";
import { readingTime } from "../../../lib/nav";
import path from "node:path";
import { parse } from "yaml";
import Base from "../../../layouts/Base.astro";
import SelectForm from "../../../components/SelectForm.astro";
import Icon from "../../../components/Icon.astro";
import "../../../styles/select.css";
import {
  SITE_DEFAULT_COMMAND,
  SITE_DEFAULT_SHAPE,
  SITE_DEFAULT_SIZE,
  loadAgentProtocolRegion,
  siteDefaultStacks,
} from "../../../lib/agent-protocol";
import {
  root,
  version,
  manifest,
  selections,
  selectionKey,
  backendStacks,
  frontendStacks,
  extensionStack,
  pageByFile,
  pageUrl,
} from "../../../lib/spec";

export function getStaticPaths() {
  return [{ params: { version } }];
}

export const prerender = true;

const siteOrigin = "https://litespec.dev";
const shapes = Object.keys(manifest.shapes);

interface PresetFile {
  shape: string;
  stacks?: string[];
}

// The form picks the stack pages a project applies, so it offers the presets that name stacks;
// the records preset names none and is set up by `litespec init` alone.
const presets = fs
  .readdirSync(path.join(root, "templates/presets"))
  .filter((file) => file.endsWith(".yaml"))
  .map((file) => {
    const parsed = parse(fs.readFileSync(path.join(root, "templates/presets", file), "utf8")) as PresetFile;
    return { name: file.slice(0, -".yaml".length), shape: parsed.shape, stacks: parsed.stacks ?? [] };
  })
  .filter((preset) => preset.stacks.length > 0)
  .sort((a, b) => (a.name < b.name ? -1 : a.name > b.name ? 1 : 0));

const extensions = Object.entries(manifest.extensions)
  .map(([id, ext]) => ({
    id,
    title: pageByFile(ext.path)?.title ?? id,
    activationScope: ext.activationScope ?? "project",
    stack: extensionStack(id),
  }))
  .sort((a, b) => (a.id < b.id ? -1 : a.id > b.id ? 1 : 0));

const selectionInfos = selections().map((selection) => ({
  shape: selection.shape,
  stacks: selection.stacks,
  key: selectionKey(selection),
}));

const defaultSize = SITE_DEFAULT_SIZE;
const defaultShape = SITE_DEFAULT_SHAPE;
const [defaultBackend = "", defaultFrontend = ""] = siteDefaultStacks();
const agentProtocolRegion = loadAgentProtocolRegion();

// The learn pages in the reading order their index states, each with a
// reading time at 220 words a minute.
const learnIndex = pageByFile("docs/learn/README.md");
const readingOrder = [...(learnIndex?.markdown ?? "").matchAll(/^- \[[^\]]+\]\(([a-z0-9-]+)\.md\): (.+)$/gm)]
  .map((match) => ({ page: pageByFile(`docs/learn/${match[1]}.md`), note: match[2] }))
  .filter((entry) => entry.page !== undefined)
  .map((entry) => ({
    title: entry.page!.title,
    url: pageUrl(entry.page!),
    note: entry.note.replace(/^./, (c) => c.toUpperCase()),
    minutes: readingTime(entry.page!),
  }));
const readingMinutes = readingOrder.reduce((sum, entry) => sum + entry.minutes, 0);

const starterPrompt = [
  `Read ${siteOrigin}/llms.txt. Pick the selection index that matches this project's shape and stacks,`,
  "then fetch only the pages each task touches.",
].join("\n");

const skillCommand = `${SITE_DEFAULT_COMMAND} skill add`;

const title = pageTitle("Use with Agents");
const description =
  "Set up an AI coding agent to follow LiteSpec: read how it works, start a session with one prompt, or answer four questions and commit the block they produce to your project's AGENTS.md file.";
---

<Base title={title} description={description} active="agents" jsonLd={[webPage({ title: "Use with Agents", description, path: `/${version}/select/` }), breadcrumbs([{ name: "LiteSpec", path: "/" }, { name: "Use with Agents", path: `/${version}/select/` }])]}>
  <div class="select-page">
    <h1>Use with Agents</h1>
    <p class="select-lead">
      An AI coding agent follows LiteSpec only when it reads the rules before it writes code. Every LiteSpec page is
      published as plain Markdown that an agent can fetch. This page sets that up: answer four questions about your
      project and commit the block they produce to its <code>AGENTS.md</code> file, which agents read at the start of
      every session, or read how LiteSpec works and start one session with a prompt.
    </p>
    <nav class="select-nav" aria-label="On this page">
      <a href="#set-up">Set Up Your Project</a>
      <a href="#how-it-works">How It Works</a>
    </nav>
    <section class="select-section" aria-labelledby="set-up-heading">
      <h2 id="set-up-heading">Set Up Your Project</h2>
      <ol class="steps">
        <SelectForm
          version={version}
          shapes={shapes}
          backendStacks={backendStacks}
          frontendStacks={frontendStacks}
          extensions={extensions}
          selections={selectionInfos}
          presets={presets}
          defaultSize={defaultSize}
          defaultShape={defaultShape}
          defaultBackend={defaultBackend}
          defaultFrontend={defaultFrontend}
          agentProtocolRegion={agentProtocolRegion}
        />
      </ol>
    </section>
    <section class="select-section" aria-labelledby="how-it-works-heading">
      <h2 id="how-it-works-heading">How It Works</h2>
      <ol class="steps">
        <li class="step">
          <span class="step-n" aria-hidden="true">1</span>
          <div class="step-body">
            <div class="step-head">
              <h2>Read the Learn Pages</h2>
              <p>
                The agent applies the rules, but you decide what it may do on its own and you review what it brings back.
                These {readingOrder.length} pages explain the rules and how LiteSpec's parts fit together, in reading
                order. They take about {readingMinutes} minutes in all.
              </p>
            </div>
            <ol class="reading">
              {
                readingOrder.map((entry) => (
                  <li>
                    <a href={entry.url}>{entry.title}</a>
                    <span class="badge">{entry.minutes} min</span>
                    <p>{entry.note}</p>
                  </li>
                ))
              }
            </ol>
          </div>
        </li>
        <li class="step">
          <span class="step-n" aria-hidden="true">2</span>
          <div class="step-body">
            <div class="step-head">
              <h2>Start a Session with One Prompt</h2>
              <p>
                Paste this prompt into an agent session to try LiteSpec without setting anything up. The agent reads the
                site index, picks the selection index that matches your project's shape and stacks, and fetches only the
                pages each task needs. The setup lasts for that session only.
              </p>
            </div>
            <section class="select-output" aria-labelledby="select-prompt-heading">
              <div class="select-output-head">
                <h3 id="select-prompt-heading">Prompt for Your Agent</h3>
                <button class="btn btn-outline btn-sm" type="button" data-copy={starterPrompt}>
                  <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy</span>
                </button>
              </div>
              <pre class="select-output-body"><code>{starterPrompt}</code></pre>
            </section>
          </div>
        </li>
        <li class="step">
          <span class="step-n" aria-hidden="true">3</span>
          <div class="step-body">
            <div class="step-head">
              <h2>Install the Skill</h2>
              <p>
                Install the LiteSpec skill so the agent loads the LiteSpec procedure on demand when it works in a
                repository that holds a <code>.litespec/project.yaml</code> file. With no flags the command covers
                Claude Code and OpenCode; the <a href={`/${version}/tools/skill/`}>skill command</a> lists the agent
                and scope options.
              </p>
            </div>
            <section class="select-output" aria-labelledby="select-skill-heading">
              <div class="select-output-head">
                <h3 id="select-skill-heading">Skill Command</h3>
                <button class="btn btn-outline btn-sm" type="button" data-copy={skillCommand}>
                  <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy</span>
                </button>
              </div>
              <pre class="select-output-body"><code>{skillCommand}</code></pre>
            </section>
          </div>
        </li>
      </ol>
    </section>
  </div>
</Base>
