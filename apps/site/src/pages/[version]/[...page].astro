---
// One HTML page per spec page: the sidebar tree, the content column with the
// breadcrumb, title, introduction, tool buttons and rendered body, the "On this page"
// list, and Previous / Next cards. Pattern pages use the full content width
// with no right column.
import Base from "../../layouts/Base.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import Icon from "../../components/Icon.astro";
import PageToc from "../../components/PageToc.astro";
import PatternViewer from "../../components/PatternViewer.astro";
import "../../styles/docs.css";
import "../../styles/prose.css";
import "../../styles/code.css";
import { folderLabel, folderOverview, foldersOf, pageName, sectionHome, sectionOf, sections } from "../../lib/areas";
import { breadcrumbs, lastModified, techArticle } from "../../lib/seo";
import { htmlPath, pageByFile, pages, pageUrl, rawUrl, version, type Page } from "../../lib/spec";
import { renderPage } from "../../lib/render-markdown";

export async function getStaticPaths() {
  // The root index is the release home at /<version>/, so only folder indexes below it get a page here.
  return pages.filter((page) => page.path !== "README").map((page) => ({ params: { version, page: htmlPath(page) }, props: { file: page.file } }));
}

interface Props {
  file: string;
}

const { file } = Astro.props as Props;
const page = pageByFile(file);
if (!page) throw new Error(`No page for ${file}`);

const { html, intro, toc } = await renderPage(page);
const section = sectionOf(page.area);
const isPattern = page.style === "pattern";
const markdownUrl = rawUrl(page);
const editUrl = `https://github.com/Litenova-Solutions/LiteSpec/blob/v${version}/${page.file}`;
const kinds = new Set(page.provisions.map((provision) => provision.kind));
const total = page.provisions.length;
const badge = total === 0 ? "" : kinds.size > 1 ? `${total} provisions` : `${total} ${page.provisions[0].kind}${total === 1 ? "" : "s"}`;
const plainLead = page.intent
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[*_`]/g, "")
  .replace(/\s+/g, " ")
  .trim();
// A short intent gives a search snippet too little to show, so it gains the page title and what LiteSpec is.
const description =
  plainLead.length >= 60
    ? plainLead.slice(0, 300)
    : `${pageName(page)}: ${plainLead === "" ? "" : `${plainLead} `}Part of LiteSpec ${version}, the specification standard for building business applications with AI agents.`;
// The breadcrumb: the release, the section, each folder between the section and
// the page, and the page. Every name is the one the sidebar shows.
const home = sectionHome(section);
const crumbs: { name: string; url: string | null }[] = [
  { name: section.label, url: home && home.file !== page.file ? pageUrl(home) : null },
  ...foldersOf(page).map((dir) => {
    const overview = folderOverview(dir);
    return { name: folderLabel(dir).label, url: overview && overview.file !== page.file ? pageUrl(overview) : null };
  }),
];
// Neighbors in sidebar order: section by section, and inside a folder its overview first,
// then its pages, then its subfolders. The root index has no page here, so it is never a neighbor.
const sectionIndex = (entry: Page) => sections.findIndex((entry2) => entry2.areas.includes(entry.area));
const treeKey = (entry: Page) => {
  const parts = entry.path.split("/");
  const name = parts.pop() ?? "";
  const overview = name === "README" || name === "stack";
  return [...parts.map((part) => `1${part}`), `0${overview ? 0 : 1}${String(pages.indexOf(entry)).padStart(4, "0")}`].join("/");
};
const ordered = pages
  .filter((entry) => entry.path !== "README" && sectionIndex(entry) >= 0)
  .sort((a, b) => sectionIndex(a) - sectionIndex(b) || (treeKey(a) < treeKey(b) ? -1 : treeKey(a) > treeKey(b) ? 1 : 0));
const at = ordered.findIndex((entry) => entry.file === page.file);
const prev = at > 0 ? ordered[at - 1] : null;
const next = at >= 0 && at < ordered.length - 1 ? ordered[at + 1] : null;
const active: "docs" | "patterns" =
  page.path === "frontend/patterns" || page.path.startsWith("frontend/patterns/") ? "patterns" : "docs";
---

<Base
  title={`${pageName(page)} - LiteSpec ${version}`}
  description={description}
  rawUrl={markdownUrl}
  active={active}
  ogType="article"
  jsonLd={[
    techArticle({ title: pageName(page), description, path: pageUrl(page), modified: lastModified(page.file), section: section.label }),
    breadcrumbs([
      { name: "LiteSpec", path: "/" },
      ...crumbs.filter((crumb) => crumb.url !== null).map((crumb) => ({ name: crumb.name, path: crumb.url! })),
      { name: pageName(page), path: pageUrl(page) },
    ]),
  ]}
>
  <div class:list={["doc3", { "doc3--full": isPattern }]}>
    <DocsSidebar current={page.file} />
    <article class="content">
      <details class="docs-browse">
        <summary class="btn btn-outline btn-sm">Browse pages<Icon name="chevron-down" class="icon-sm chev" /></summary>
        <div class="docs-browse-panel">
          <DocsSidebar current={page.file} />
        </div>
      </details>
      <div class="docs-body" data-pagefind-body>
        <nav class="crumb" aria-label="Breadcrumb">
          <span class="ver">{version}</span>
          {crumbs.map((crumb, index) => (
            <>
              <span aria-hidden="true">/</span>
              {crumb.url ? (
                <a class:list={[{ "crumb-area": index === 0 }]} href={crumb.url}>{index === 0 && <Icon name={section.icon} class="icon-sm" />}{crumb.name}</a>
              ) : (
                <span class:list={["crumb-text", { "crumb-area": index === 0 }]}>{index === 0 && <Icon name={section.icon} class="icon-sm" />}{crumb.name}</span>
              )}
            </>
          ))}
          <span aria-hidden="true">/</span>
          <b>{page.title}</b>
        </nav>
        <h1 data-pagefind-meta={`title:${pageName(page)}`}>{page.title}</h1>
        {intro !== "" && <div class="page-intro prose" set:html={intro} />}
        <div class="tools" data-pagefind-ignore>
          <button class="btn btn-outline btn-sm" type="button" data-copy-url={markdownUrl}>
            <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy page</span>
          </button>
          <a class="btn btn-outline btn-sm" href={markdownUrl}>
            <Icon name="file" class="icon-sm" />Markdown
          </a>
          {badge !== "" && <span class="badge tools-badge">{badge}</span>}
        </div>
        <div class="prose" set:html={html} />
      </div>
      <nav class="pager" aria-label="Pages">
        {prev && (
          <a class="pager-prev" href={pageUrl(prev)}>
            <small><Icon name="arrow-left" class="icon-sm" />Previous</small>
            <b>{pageName(prev)}</b>
          </a>
        )}
        {next && (
          <a class="pager-next" href={pageUrl(next)}>
            <small>Next<Icon name="arrow" class="icon-sm" /></small>
            <b>{pageName(next)}</b>
          </a>
        )}
      </nav>
    </article>
    {!isPattern && <PageToc entries={toc} markdownUrl={markdownUrl} editUrl={editUrl} />}
  </div>
  {isPattern && <PatternViewer />}
</Base>
