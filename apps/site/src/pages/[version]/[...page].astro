---
// One HTML page per spec page: the sidebar tree, the content column with the
// browse button, breadcrumb, title, meta row, introduction, tool buttons and
// rendered body, the "On this page" list, and Previous / Next cards. Pattern
// pages add the pattern viewer beside the same frame.
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import DocsSidebar from "../../components/DocsSidebar.astro";
import Icon from "../../components/Icon.astro";
import PageToc from "../../components/PageToc.astro";
import PatternViewer from "../../components/PatternViewer.astro";
import "../../styles/docs.css";
import "../../styles/prose.css";
import "../../styles/code.css";
import { groupOf, pageName } from "../../lib/areas";
import { crumbTrail, pageNeighbors } from "../../lib/nav";
import { breadcrumbs, lastModified, pageTitle, techArticle } from "../../lib/seo";
import { htmlPath, pageByFile, pages, pageUrl, rawUrl, version, type Page } from "../../lib/spec";
import { renderPage } from "../../lib/render-markdown";

export async function getStaticPaths() {
  // The root index is the release home at /<version>/, so only folder indexes below it get a page here.
  return pages.filter((page) => page.path !== "README").map((page) => ({ params: { version, page: htmlPath(page) }, props: { file: page.file } }));
}

interface Props {
  file: string;
}

const { file } = Astro.props as Props;
const page = pageByFile(file);
if (!page) throw new Error(`No page for ${file}`);

const { html, intro, toc, meta } = await renderPage(page);
const group = groupOf(page.area);
const isPattern = page.style === "pattern";
const markdownUrl = rawUrl(page);
const editUrl = `https://github.com/Litenova-Solutions/LiteSpec/blob/v${version}/${page.file}`;
const kinds = new Set(page.provisions.map((provision) => provision.kind));
const total = page.provisions.length;
const badge = total === 0 ? "" : kinds.size > 1 ? `${total} provisions` : `${total} ${page.provisions[0].kind}${total === 1 ? "" : "s"}`;
const plainLead = page.intent
  .replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
  .replace(/[*_`]/g, "")
  .replace(/\s+/g, " ")
  .trim();
// A short intent gives a search snippet too little to show, so it gains the page title and what LiteSpec is.
const description =
  plainLead.length >= 60
    ? plainLead.slice(0, 300)
    : `${pageName(page)}: ${plainLead === "" ? "" : `${plainLead} `}Part of LiteSpec ${version}, the specification standard for building business applications with AI agents.`;
// The breadcrumb ancestors from the navigation order: the group, the area or
// folders, each linked to its overview. The sidebar and the pager read the
// same order, so all three agree about where the page sits.
const trail = crumbTrail(page);
const neighbors: { prev: Page | null; next: Page | null; nextGroup: { url: string; label: string } | null } = pageNeighbors(page);
---

<Base
  title={pageTitle(pageName(page), group.label)}
  description={description}
  rawUrl={markdownUrl}
  ogType="article"
  jsonLd={[
    techArticle({ title: pageName(page), description, path: pageUrl(page), modified: lastModified(page.file), section: group.label }),
    breadcrumbs([
      { name: "LiteSpec", path: "/" },
      ...trail.map((crumb) => ({ name: crumb.name, path: crumb.url })),
      { name: page.title, path: null },
    ]),
  ]}
>
  <div class="doc3">
    <DocsSidebar current={page.file} />
    <article class="content">
      <button type="button" class="btn btn-outline btn-sm docs-browse-btn" data-open-docs>Browse docs</button>
      <script is:inline>
        (function () {
          var button = document.querySelector("[data-open-docs]");
          var dialog = document.getElementById("docs-drawer");
          if (!(button instanceof HTMLButtonElement) || !(dialog instanceof HTMLDialogElement)) return;
          button.addEventListener("click", function () {
            dialog.showModal();
            var on = dialog.querySelector("a.on");
            if (on && on.scrollIntoView) on.scrollIntoView({ block: "nearest" });
            var filter = dialog.querySelector("[data-docs-filter]");
            if (filter instanceof HTMLInputElement) filter.focus();
          });
        })();
      </script>
      <div class="docs-body" data-pagefind-body data-pagefind-meta={`group:${group.label}`}>
        <Breadcrumbs items={trail} icon={group.icon} current={page.title} />
        <h1 data-pagefind-meta={`title:${pageName(page)}`}>{page.title}</h1>
        {meta.length > 0 && (
          <p class="page-meta" data-pagefind-ignore>
            {meta.map((pair) => (
              <span><span class="meta-label">{pair.label}:</span> <span set:html={pair.value} /></span>
            ))}
          </p>
        )}
        {intro !== "" && <div class="page-intro prose" set:html={intro} />}
        <div class="tools" data-pagefind-ignore>
          <button class="btn btn-outline btn-sm" type="button" data-copy-url={markdownUrl}>
            <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy page</span>
          </button>
          <a class="btn btn-outline btn-sm" href={markdownUrl}>
            <Icon name="file" class="icon-sm" />Markdown
          </a>
          {badge !== "" && <span class="badge tools-badge">{badge}</span>}
        </div>
        <PageToc entries={toc} markdownUrl={markdownUrl} editUrl={editUrl} mobile />
        <div class="prose" set:html={html} />
      </div>
      <nav class="pager" aria-label="Pages">
        {neighbors.prev && (
          <a class="pager-prev" href={pageUrl(neighbors.prev)}>
            <small><Icon name="arrow-left" class="icon-sm" />Previous</small>
            <b>{pageName(neighbors.prev)}</b>
          </a>
        )}
        {neighbors.next && (
          <a class="pager-next" href={pageUrl(neighbors.next)}>
            <small>Next<Icon name="arrow" class="icon-sm" /></small>
            <b>{pageName(neighbors.next)}</b>
          </a>
        )}
        {!neighbors.next && neighbors.nextGroup && (
          <a class="pager-next" href={neighbors.nextGroup.url}>
            <small>Next<Icon name="arrow" class="icon-sm" /></small>
            <b>{neighbors.nextGroup.label}</b>
          </a>
        )}
      </nav>
    </article>
    <PageToc entries={toc} markdownUrl={markdownUrl} editUrl={editUrl} />
  </div>
  {isPattern && <PatternViewer />}
</Base>
