---
// The page Cloudflare serves for any path that matches no file (not_found_handling: 404-page).
import Base from "../layouts/Base.astro";
import { version } from "../lib/spec";
import { pageTitle } from "../lib/seo";
---

<Base title={pageTitle("Page Not Found")} description="The page you asked for is not part of this LiteSpec release." noindex>
  <section class="missing">
    <div class="wrap">
      <span class="ver">404</span>
      <h1>Page Not Found</h1>
      <p>That address is not part of LiteSpec {version}. Start from Learn, look up a rule in the Standard, or search every page by its title or by a word in its rules.</p>
      <div class="act">
        <a class="btn" href={`/${version}/learn/`}>Open Learn</a>
        <a class="btn btn-outline" href={`/${version}/standard/`}>Browse the Standard</a>
        <button class="btn btn-outline" type="button" data-open-search>Search the docs</button>
      </div>
    </div>
  </section>
  <script is:inline>
    // The search dialog lives in the header; this button opens it from here.
    (function () {
      var button = document.querySelector("[data-open-search]");
      if (!(button instanceof HTMLButtonElement)) return;
      button.addEventListener("click", function () {
        var trigger = document.querySelector("[data-search-trigger]");
        if (trigger instanceof HTMLButtonElement) trigger.click();
      });
    })();
  </script>
</Base>

<style>
  .missing { flex: 1; display: flex; align-items: center; padding: var(--space-24) 0; }
  .missing .wrap { width: 100%; padding: 0 var(--space-16); }
  .missing h1 { font-size: 48px; line-height: 1.05; letter-spacing: -.04em; font-weight: 600; margin: var(--space-5) 0 var(--space-heading); }
  .missing p { color: var(--muted-fg); font-size: 17px; max-width: 56ch; }
  .missing .act { display: flex; flex-wrap: wrap; gap: var(--gap-inline); margin-top: var(--space-8); }
  @media (max-width: 760px) {
    .missing .wrap { padding: 0 var(--space-4); }
    .missing h1 { font-size: 36px; }
  }
</style>
