---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import { version } from "../lib/spec";
import { softwareSource, website } from "../lib/seo";

const description =
  "LiteSpec is a versioned specification for building business applications with AI coding agents: architecture, code, records, and tests, in a form agents can read and tools can verify.";
---

<Base title="LiteSpec - Specification standard for agent-built applications" description={description} jsonLd={[website, softwareSource]}>
  <section class="hero">
    <div class="hero-body">
      <a class="badge" href="https://github.com/Litenova-Solutions/LiteSpec/blob/main/CHANGELOG.md"><span class="dot"></span>v{version} <Icon name="arrow" class="icon-sm" /></a>
      <h1>The specification standard for building business applications with AI agents</h1>
      <p class="tagline">One versioned standard for the architecture, code, records, and tests of a business application. Agents load the rules that apply to your stack; tools check that the code follows them.</p>
      <div class="actions">
        <a class="btn" href={`/${version}/learn/`}>Get started</a>
        <a class="btn btn-outline" href={`/${version}/select/`}>Connect your agent</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero {
    flex: 1;
    display: flex;
    align-items: center;
    position: relative;
    isolation: isolate;
    padding: 120px 0;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--border) 1px, transparent 1px),
      linear-gradient(90deg, var(--border) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: 63px 63px;
    -webkit-mask-image: radial-gradient(ellipse 70% 70% at 70% 50%, black 0%, transparent 75%);
    mask-image: radial-gradient(ellipse 70% 70% at 70% 50%, black 0%, transparent 75%);
    opacity: 0.7;
  }
  .hero-body {
    width: 100%;
    padding: 0 64px;
  }
  .hero h1 {
    font-size: 52px;
    line-height: 1.08;
    letter-spacing: -0.04em;
    font-weight: 600;
    max-width: 22ch;
    margin: 22px 0 18px;
  }
  .tagline {
    font-size: 18px;
    color: var(--muted-fg);
    max-width: 62ch;
  }
  .actions {
    display: flex;
    gap: 10px;
    margin-top: 32px;
  }
  .hero a.badge:hover {
    border-color: var(--rail);
    color: var(--fg);
  }
  @media (max-width: 760px) {
    .hero {
      padding: 72px 0;
    }
    .hero-body {
      padding: 0 16px;
    }
    .hero h1 {
      font-size: 32px;
    }
    .actions {
      flex-wrap: wrap;
    }
  }
</style>
