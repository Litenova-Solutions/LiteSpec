---
import Icon from "./Icon.astro";
---

<button type="button" class="search-trigger" data-search-trigger aria-haspopup="dialog" aria-label="Search (Ctrl K)">
  <Icon name="search" />
  <span class="search-trigger-label">Search</span>
  <span class="kbd" aria-hidden="true">Ctrl K</span>
</button>
<dialog class="search-dialog" data-search-dialog aria-label="Search the docs">
  <div class="search-bar">
    <Icon name="search" />
    <input type="text" data-search-input placeholder="Search the docs" aria-label="Search the docs" autocomplete="off" spellcheck="false" />
    <span class="kbd" aria-hidden="true">Esc</span>
  </div>
  <div class="search-results" data-search-results>
    <p class="search-hint muted">Type to search pages and rules.</p>
  </div>
</dialog>
<style>
  .search-trigger {
    display: flex;
    align-items: center;
    gap: var(--gap-inline);
    width: 240px;
    height: 32px;
    padding: 0 var(--space-2);
    background: var(--muted);
    border: 1px solid transparent;
    border-radius: var(--radius);
    color: var(--muted-fg);
    font-size: 13px;
    cursor: pointer;
  }
  .search-trigger:hover {
    border-color: var(--border);
  }
  .search-trigger-label {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .search-trigger .kbd {
    margin-left: auto;
  }
  .search-dialog {
    width: min(640px, 100vw - 32px);
    margin: 12vh auto 0;
    padding: 0;
    background: var(--bg);
    color: var(--fg);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: none;
  }
  .search-dialog::backdrop {
    background: color-mix(in srgb, var(--outside) 70%, transparent);
  }
  .search-bar {
    display: flex;
    align-items: center;
    gap: var(--gap-inline);
    padding: var(--pad-box-y) var(--pad-box-x);
    border-bottom: 1px solid var(--border);
    color: var(--muted-fg);
  }
  .search-bar input {
    flex: 1;
    min-width: 0;
    padding: 0;
    border: 0;
    outline: none;
    box-shadow: none;
    background: transparent;
    color: var(--fg);
    font-size: 15px;
    font-family: var(--sans);
  }
  .search-bar input:focus,
  .search-bar input:focus-visible {
    outline: none;
    box-shadow: none;
    border: 0;
  }
  .search-results {
    max-height: 60vh;
    overflow-y: auto;
    padding: var(--space-2);
  }
  :global(.search-dialog .search-hint) {
    margin: 0;
    padding: var(--space-4) var(--space-3);
    font-size: 13px;
    color: var(--muted-fg);
  }
  :global(.search-dialog .search-item) {
    display: grid;
  }
  :global(.search-dialog .search-item + .search-item) {
    border-top: 1px solid var(--border);
  }
  :global(.search-dialog .search-result) {
    display: grid;
    gap: var(--space-1);
    padding: var(--pad-box-y) var(--pad-box-x);
    border-left: 2px solid transparent;
    border-radius: var(--radius-sm);
    color: var(--fg);
  }
  :global(.search-dialog .search-result-title) {
    display: block;
    font-weight: 500;
    font-size: 14px;
  }
  :global(.search-dialog .search-result-excerpt) {
    display: block;
    font-size: 13px;
    color: var(--muted-fg);
  }
  :global(.search-dialog .search-result-excerpt mark) {
    background: var(--accent-soft);
    color: var(--fg);
    border-radius: 2px;
    padding: 0 1px;
  }
  :global(.search-dialog .search-sub) {
    display: block;
    padding: var(--pad-box-y) var(--pad-box-x) var(--pad-box-y) var(--space-8);
    font-size: 13px;
    color: var(--muted-fg);
    border-left: 2px solid transparent;
    border-radius: var(--radius-sm);
  }
  :global(.search-dialog .search-sub:hover) {
    color: var(--fg);
  }
  :global(.search-dialog a.is-selected) {
    background: var(--accent-subtle);
    border-left-color: var(--accent);
  }
  @media (max-width: 760px) {
    .search-trigger {
      width: 32px;
      padding: 0;
      justify-content: center;
    }
    .search-trigger-label,
    .search-trigger .kbd {
      display: none;
    }
  }
</style>
<script>
  (function () {
    var trigger = document.querySelector("[data-search-trigger]");
    var dialog = document.querySelector("[data-search-dialog]");
    var input = document.querySelector("[data-search-input]");
    var results = document.querySelector("[data-search-results]");
    if (
      !(trigger instanceof HTMLButtonElement) ||
      !(dialog instanceof HTMLDialogElement) ||
      !(input instanceof HTMLInputElement) ||
      !(results instanceof HTMLElement)
    ) {
      return;
    }

    var HINT = "Type to search pages and rules.";
    var UNAVAILABLE = "Search is available on the built site.";
    var selected = -1;
    var requestId = 0;
    var pagefindModule = null;
    var pagefindState = "idle";
    var pagefindPromise = null;

    function links() {
      return Array.prototype.slice.call(results.querySelectorAll("a"));
    }

    function showHint(text) {
      results.innerHTML = "";
      var hint = document.createElement("p");
      hint.className = "search-hint muted";
      hint.textContent = text;
      results.appendChild(hint);
      selected = -1;
    }

    function loadPagefind() {
      if (pagefindState === "ready") return Promise.resolve(pagefindModule);
      if (pagefindState === "unavailable") return Promise.resolve(null);
      if (pagefindPromise) return pagefindPromise;
      pagefindState = "loading";
      pagefindPromise = (async function () {
        try {
          var path = "/pagefind/pagefind.js";
          var mod = await import(/* @vite-ignore */ path);
          pagefindModule = mod;
          pagefindState = "ready";
          return mod;
        } catch (err) {
          pagefindState = "unavailable";
          pagefindPromise = null;
          return null;
        }
      })();
      return pagefindPromise;
    }

    function render(entries, term) {
      results.innerHTML = "";
      selected = -1;
      if (entries.length === 0) {
        var empty = document.createElement("p");
        empty.className = "search-hint muted";
        empty.textContent = "No results for " + term;
        results.appendChild(empty);
        return;
      }
      entries.forEach(function (entry) {
        var item = document.createElement("div");
        item.className = "search-item";
        var link = document.createElement("a");
        link.className = "search-result";
        link.setAttribute("href", entry.url);
        var title = document.createElement("span");
        title.className = "search-result-title";
        title.textContent = (entry.meta && entry.meta.title) || entry.url;
        link.appendChild(title);
        if (entry.excerpt) {
          var excerpt = document.createElement("span");
          excerpt.className = "search-result-excerpt";
          excerpt.innerHTML = entry.excerpt;
          link.appendChild(excerpt);
        }
        item.appendChild(link);
        var subs = (entry.sub_results || [])
          .filter(function (sub) {
            return sub.url !== entry.url;
          })
          .slice(0, 3);
        subs.forEach(function (sub) {
          var subLink = document.createElement("a");
          subLink.className = "search-sub";
          subLink.setAttribute("href", sub.url);
          subLink.textContent = sub.title;
          item.appendChild(subLink);
        });
        results.appendChild(item);
      });
    }

    function paintSelection() {
      links().forEach(function (anchor, index) {
        anchor.classList.toggle("is-selected", index === selected);
        if (index === selected) anchor.scrollIntoView({ block: "nearest" });
      });
    }

    function move(delta) {
      var all = links();
      if (all.length === 0) return;
      selected = (selected + delta + all.length) % all.length;
      paintSelection();
    }

    function runSearch(term) {
      var id = ++requestId;
      if (term === "") {
        if (pagefindState !== "unavailable") showHint(HINT);
        else showHint(UNAVAILABLE);
        return;
      }
      loadPagefind().then(function (mod) {
        if (id !== requestId) return;
        if (!mod) {
          showHint(UNAVAILABLE);
          return;
        }
        mod
          .debouncedSearch(term)
          .then(function (search) {
            if (id !== requestId) return;
            if (search === null) return;
            var pending = search.results.slice(0, 8).map(function (result) {
              return result.data().catch(function () {
                return null;
              });
            });
            Promise.all(pending).then(function (loaded) {
              if (id !== requestId) return;
              render(
                loaded.filter(function (entry) {
                  return entry !== null;
                }),
                term
              );
            });
          })
          .catch(function () {
            if (id !== requestId) return;
            showHint("No results for " + term);
          });
      });
    }

    function open() {
      if (!dialog.open) dialog.showModal();
      input.focus();
      if (pagefindState === "unavailable") showHint(UNAVAILABLE);
      else if (input.value.trim() === "" && links().length === 0) showHint(HINT);
    }

    trigger.addEventListener("click", open);

    dialog.addEventListener("click", function (event) {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener("close", function () {
      selected = -1;
      paintSelection();
    });

    results.addEventListener("mouseover", function (event) {
      var target = event.target instanceof Element ? event.target.closest("a") : null;
      if (!target) return;
      var index = links().indexOf(target);
      if (index !== -1 && index !== selected) {
        selected = index;
        paintSelection();
      }
    });

    input.addEventListener("input", function () {
      runSearch(input.value.trim());
    });

    input.addEventListener("keydown", function (event) {
      if (event.key === "ArrowDown" || event.key === "ArrowUp") {
        event.preventDefault();
        move(event.key === "ArrowDown" ? 1 : -1);
      } else if (event.key === "Enter") {
        var current = links()[selected];
        if (current) {
          event.preventDefault();
          window.location.href = current.getAttribute("href") || "/";
        }
      }
    });

    document.addEventListener("keydown", function (event) {
      if ((event.ctrlKey || event.metaKey) && (event.key === "k" || event.key === "K")) {
        event.preventDefault();
        if (dialog.open) dialog.close();
        else open();
        return;
      }
      if (
        event.key === "/" &&
        !event.ctrlKey &&
        !event.metaKey &&
        !event.altKey &&
        !dialog.open
      ) {
        var target = event.target;
        var tag = target instanceof HTMLElement ? target.tagName : "";
        var typing =
          tag === "INPUT" ||
          tag === "TEXTAREA" ||
          tag === "SELECT" ||
          (target instanceof HTMLElement && target.isContentEditable);
        if (!typing) {
          event.preventDefault();
          open();
        }
      }
    });
  })();
</script>
