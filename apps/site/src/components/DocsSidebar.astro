---
// Left navigation of the docs pages: the full documentation tree grouped by
// section, with collapsible folders. Every link is named by its page's title,
// the same name the page's heading, breadcrumb and browser tab use; a folder's
// overview page comes first inside it. The tree is built as a string because
// Astro components cannot recurse; icons come from the shared icon paths.
import { folderLabel, folderOverview, inDir, sectionOverview, sections } from "../lib/areas";
import { paths } from "../lib/icons";
import { pages, pageUrl, type Page } from "../lib/spec";

interface Props {
  /** Repository-relative file of the current page, such as docs/core/scope.md. */
  current: string;
}

const { current } = Astro.props;

const escapeHtml = (value: string): string =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const iconSvg = (name: string, cls: string): string =>
  `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${(paths as Record<string, string>)[name] ?? ""}</svg>`;

/** Immediate subfolders of a folder that hold pages, in ordinal order. */
const childDirs = (dir: string): string[] => {
  const out = new Set<string>();
  for (const page of pages) {
    if (!page.file.startsWith(`${dir}/`)) continue;
    const rest = page.file.slice(dir.length + 1);
    const slash = rest.indexOf("/");
    if (slash >= 0) out.add(`${dir}/${rest.slice(0, slash)}`);
  }
  return [...out].sort();
};

const link = (page: Page): string =>
  page.file === current
    ? `<a class="on" href="${escapeHtml(pageUrl(page))}" aria-current="page">${escapeHtml(page.title)}</a>`
    : `<a href="${escapeHtml(pageUrl(page))}">${escapeHtml(page.title)}</a>`;

/** Pages that open a subfolder of their own folder, listed inside that subfolder instead. */
const opensSubfolder = (page: Page, dir: string): boolean =>
  childDirs(dir).some((sub) => folderOverview(sub) === page);

/** A folder's links: its overview first, then its pages, then its subfolders. A
 *  section overview already listed first is skipped. */
const folderLinks = (dir: string, skip?: Page): string => {
  const overview = folderOverview(dir);
  let inner = overview && overview !== skip ? link(overview) : "";
  for (const page of inDir(dir).filter((page) => page !== overview && page !== skip && !opensSubfolder(page, dir))) inner += link(page);
  for (const sub of childDirs(dir)) inner += folderTree(sub);
  return inner;
};

const folderTree = (dir: string): string => {
  const { label, stack } = folderLabel(dir);
  const tag = stack ? `<span class="tag">stack</span>` : "";
  const open = current.startsWith(`${dir}/`) ? " open" : "";
  return `<details${open}><summary>${escapeHtml(label)}${tag}${iconSvg("chevron", "icon chev")}</summary><div class="kids">${folderLinks(dir)}</div></details>`;
};

const sidebar = sections
  .map((section) => {
    const count = pages.filter((page) => section.areas.includes(page.area)).length;
    const holds = section.areas.some((area) => current.startsWith(`docs/${area}/`));
    const open = section.key === "learn" || holds;
    const overview = sectionOverview(section);
    const inner = (overview ? link(overview) : "") + section.areas.map((area) => folderLinks(`docs/${area}`, overview)).join("");
    return (
      `<details class="sec"${open ? " open" : ""}>` +
      `<summary class="sec-h collapse${holds ? " open-here" : ""}">${iconSvg(section.icon, "icon")}${escapeHtml(section.label)}<span class="count">${count}</span>${iconSvg("chevron", "icon chev")}</summary>` +
      `<div class="tree">${inner}</div></details>`
    );
  })
  .join("");
---

<nav class="side" aria-label="Documentation" set:html={sidebar}></nav>
