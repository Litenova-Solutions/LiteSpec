---
// Left navigation of the docs pages: the full documentation tree grouped by docs
// group, with an area label above each area inside a multi-area group and
// collapsible folders. Every link is named by its page's title, the same name
// the page's heading, breadcrumb and browser tab use; a folder's overview page
// comes first inside it. The tree is built as a string because Astro components
// cannot recurse; icons come from the shared icon paths.
import { areaLabel, folderLabel, folderOverview, groups, inDir } from "../lib/areas";
import { escape } from "../lib/html";
import { paths } from "../lib/icons";
import { pages, pageUrl, type Page } from "../lib/spec";

interface Props {
  /** Repository-relative file of the current page, such as docs/core/scope.md. */
  current: string;
}

const { current } = Astro.props;

const iconSvg = (name: string, cls: string): string =>
  `<svg class="${cls}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${(paths as Record<string, string>)[name] ?? ""}</svg>`;

/** Immediate subfolders of a folder that hold pages, in ordinal order. */
const childDirs = (dir: string): string[] => {
  const out = new Set<string>();
  for (const page of pages) {
    if (!page.file.startsWith(`${dir}/`)) continue;
    const rest = page.file.slice(dir.length + 1);
    const slash = rest.indexOf("/");
    if (slash >= 0) out.add(`${dir}/${rest.slice(0, slash)}`);
  }
  return [...out].sort();
};

const link = (page: Page): string =>
  page.file === current
    ? `<a class="on" href="${escape(pageUrl(page))}" aria-current="page">${escape(page.title)}</a>`
    : `<a href="${escape(pageUrl(page))}">${escape(page.title)}</a>`;

/** Pages that open a subfolder of their own folder, listed inside that subfolder instead. */
const opensSubfolder = (page: Page, dir: string): boolean =>
  childDirs(dir).some((sub) => folderOverview(sub) === page);

/** A folder's links: its overview first, then its pages, then its subfolders. */
const folderLinks = (dir: string): string => {
  const overview = folderOverview(dir);
  let inner = overview ? link(overview) : "";
  for (const page of inDir(dir).filter((page) => page !== overview && !opensSubfolder(page, dir))) inner += link(page);
  for (const sub of childDirs(dir)) inner += folderTree(sub);
  return inner;
};

const folderTree = (dir: string): string => {
  const { label, stack } = folderLabel(dir);
  const tag = stack ? `<span class="tag">stack</span>` : "";
  const open = current.startsWith(`${dir}/`) ? " open" : "";
  return `<details${open}><summary>${escape(label)}${tag}${iconSvg("chevron", "icon chev")}</summary><div class="kids">${folderLinks(dir)}</div></details>`;
};

const sidebar = groups
  .map((group) => {
    const count = pages.filter((page) => group.areas.includes(page.area)).length;
    const holds = group.areas.some((area) => current.startsWith(`docs/${area}/`));
    const open = group.key === "learn" || holds;
    const inner = group.areas
      .map((area) => {
        const head = group.areas.length > 1 ? `<div class="area-h">${escape(areaLabel(area))}</div>` : "";
        return head + folderLinks(`docs/${area}`);
      })
      .join("");
    return (
      `<details class="group"${open ? " open" : ""}>` +
      `<summary class="group-h collapse${holds ? " open-here" : ""}">${iconSvg(group.icon, "icon")}${escape(group.label)}<span class="count">${count}</span>${iconSvg("chevron", "icon chev")}</summary>` +
      `<div class="tree">${inner}</div></details>`
    );
  })
  .join("");
---

<nav class="side" aria-label="Documentation" set:html={sidebar}></nav>
