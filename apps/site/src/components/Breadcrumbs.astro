---
// The breadcrumb of a docs page: its group, area and folders, then the page.
// Every ancestor links to its overview; the current page is text. Separators
// come from CSS, so assistive technology hears one ordered list.
import type { IconName } from "../lib/icons";
import Icon from "./Icon.astro";

interface Props {
  /** The ancestors from lib/nav.ts crumbTrail: group, area, then folders. */
  items: { name: string; url: string | null }[];
  /** The icon of the group crumb, shown before the group name. */
  icon?: IconName;
  /** The current page title, shown as text. */
  current: string;
}

const { items, icon, current } = Astro.props;
---

<nav class="crumb" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.url ? (
            <a class:list={[{ "crumb-area": index === 0 }]} href={item.url}>
              {index === 0 && icon && <Icon name={icon} class="icon-sm" />}{item.name}
            </a>
          ) : (
            <span class:list={["crumb-text", { "crumb-area": index === 0 }]}>
              {index === 0 && icon && <Icon name={icon} class="icon-sm" />}{item.name}
            </span>
          )}
        </li>
      ))
    }
    <li><span class:list={["crumb-current", { "crumb-area": items.length === 0 }]} aria-current="page">{items.length === 0 && icon && <Icon name={icon} class="icon-sm" />}{current}</span></li>
  </ol>
</nav>
