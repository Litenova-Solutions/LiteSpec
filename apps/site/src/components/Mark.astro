// an L and three saffron rules on the Litenova Solutions grid (assets/README.md).
// The frame, the L and the name take --mark-ink, navy on light and paper on dark;
// the rules take --mark-symbol. With `name`, it draws the horizontal lockup, the
// name in Manrope Bold as outlines. Use it at 24px or taller; below that the
// favicon files carry the heavier cut.
interface Props {
  /** The height in pixels. */
  size?: number;
  /** Draws the name beside the mark. */
  name?: boolean;
}

