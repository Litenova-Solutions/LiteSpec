---
/* Steps 3 and 4 of /[version]/select/: the selection questions, one row each,
   and the AGENTS.md block they produce. Rendered statically with default
   values, then updated live by one small inline script. */
import Icon from "./Icon.astro";

export interface ExtensionInfo {
  id: string;
  title: string;
  activationScope: string;
  stack: string | null;
  layerUrl: string;
}

export interface SelectionInfo {
  shape: string;
  stacks: string[];
  key: string;
  indexUrl: string;
}

export interface PresetInfo {
  name: string;
  shape: string;
  stacks: string[];
}

interface Props {
  version: string;
  siteOrigin: string;
  shapes: string[];
  backendStacks: string[];
  frontendStacks: string[];
  extensions: ExtensionInfo[];
  selections: SelectionInfo[];
  presets: PresetInfo[];
  defaultSize: string;
  defaultShape: string;
  defaultBackend: string;
  defaultFrontend: string;
  initialAgents: string;
}

const {
  version,
  siteOrigin,
  shapes,
  backendStacks,
  frontendStacks,
  extensions,
  selections,
  presets,
  defaultSize,
  defaultShape,
  defaultBackend,
  defaultFrontend,
  initialAgents,
} = Astro.props as Props;

const payload = JSON.stringify({
  version,
  siteOrigin,
  shapes,
  backendStacks,
  frontendStacks,
  extensions,
  selections,
  presets,
  defaultSize,
  defaultShape,
  defaultBackend,
  defaultFrontend,
});

function capitalize(value: string): string {
  return value.length === 0 ? value : value.charAt(0).toUpperCase() + value.slice(1);
}

function joinList(items: string[]): string {
  if (items.length === 0) return "none";
  if (items.length === 1) return items[0];
  if (items.length === 2) return `${items[0]} and ${items[1]}`;
  return `${items.slice(0, -1).join(", ")} and ${items[items.length - 1]}`;
}

function sameMembers(a: string[], b: string[]): boolean {
  return a.length === b.length && a.every((item) => b.includes(item));
}

const defaultStackList =
  defaultShape === "server"
    ? defaultFrontend ? [defaultBackend, defaultFrontend] : [defaultBackend]
    : defaultFrontend ? [defaultFrontend] : [];
const defaultPresetName =
  presets.find((preset) => preset.shape === defaultShape && sameMembers(preset.stacks, defaultStackList))?.name ?? "";
---

<li class="step">
  <span class="step-n" aria-hidden="true">3</span>
  <div class="step-body">
    <div class="step-head">
      <h2>Tailor it to your project</h2>
      <p>
        For a repository you keep. Your answers pick one selection index: an <code>llms.txt</code> that lists only the
        pages your project applies.
      </p>
    </div>
    <form id="select-form" class="select-form">
      <fieldset class="select-row">
        <legend class="select-label">Preset<span>Fills in the shape and stacks. Change them after.</span></legend>
        <div class="select-seg">
          {
            presets.map((preset) => (
              <label title={`${capitalize(preset.shape)}: ${joinList(preset.stacks)}.`}>
                <input
                  class="visually-hidden"
                  type="radio"
                  name="preset"
                  value={preset.name}
                  checked={defaultPresetName === preset.name}
                  data-preset-option={preset.name}
                />
                <span>{preset.name}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="select-row">
        <legend class="select-label">Size<span>Small: one team, no journeys or cases. Large adds journeys, cases, and the Acceptance project.</span></legend>
        <div class="select-seg">
          <label><input class="visually-hidden" type="radio" name="size" value="small" checked={defaultSize === "small"} /><span>Small</span></label>
          <label><input class="visually-hidden" type="radio" name="size" value="large" checked={defaultSize === "large"} /><span>Large</span></label>
        </div>
      </fieldset>
      <fieldset class="select-row">
        <legend class="select-label">Shape<span>Server: one API deployable and one database. Client-only: no server of its own.</span></legend>
        <div class="select-seg">
          {
            shapes.map((shape) => (
              <label>
                <input class="visually-hidden" type="radio" name="shape" id={`select-shape-${shape}`} value={shape} checked={defaultShape === shape} />
                <span>{capitalize(shape)}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="select-row" id="select-backend-group">
        <legend class="select-label">Backend stack<span id="select-backend-note">One backend stack for a server project.</span></legend>
        <div class="select-seg">
          {
            backendStacks.map((id) => (
              <label>
                <input class="visually-hidden" type="radio" name="backend" id={`select-backend-${id}`} value={id} checked={defaultBackend === id} data-backend-option={id} />
                <span>{id}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="select-row">
        <legend class="select-label">Frontend stack<span>One stack per frontend, or none. A stack that no published selection pairs with your answers is disabled.</span></legend>
        <div class="select-seg">
          <label><input class="visually-hidden" type="radio" name="frontend" id="select-frontend-none" value="" checked={defaultFrontend === ""} data-frontend-option="none" /><span>None</span></label>
          {
            frontendStacks.map((id) => (
              <label>
                <input class="visually-hidden" type="radio" name="frontend" id={`select-frontend-${id}`} value={id} checked={defaultFrontend === id} data-frontend-option={id} />
                <span>{id}</span>
              </label>
            ))
          }
        </div>
      </fieldset>
      <fieldset class="select-row">
        <legend class="select-label">Extensions<span>Each applies only when you select it. Only extensions that support your stacks are listed.</span></legend>
        <ul class="select-exts">
          {
            extensions.map((ext) => (
              <li data-extension-row={ext.id}>
                <label>
                  <input type="checkbox" name="extension" id={`select-ext-${ext.id}`} value={ext.id} data-extension-option={ext.id} data-extension-stack={ext.stack ?? ""} />
                  <span class="select-ext-title">{ext.title}</span>
                  <code>{ext.id}</code>
                  <span class="select-ext-scope">{ext.stack ? `${ext.stack} only` : `${ext.activationScope || "project"} scope`}</span>
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </form>
  </div>
</li>
<li class="step">
  <span class="step-n" aria-hidden="true">4</span>
  <div class="step-body">
    <div class="step-head">
      <h2>Copy it into your project</h2>
      <p>Commit this block to your project's <code>AGENTS.md</code>. Every agent session then reads your selection before a task.</p>
    </div>
    <section class="select-output" aria-live="polite" aria-labelledby="select-agents-heading">
      <div class="select-output-head">
        <h3 id="select-agents-heading">AGENTS.md block</h3>
        <button class="btn btn-outline btn-sm" type="button" id="select-copy-agents" data-copy={initialAgents}>
          <Icon name="copy" class="icon-sm" /><span class="copy-label">Copy</span>
        </button>
      </div>
      <pre class="select-output-body"><code id="select-agents">{initialAgents}</code></pre>
    </section>
  </div>
</li>
<style>
  .select-form {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    min-width: 0;
  }
  .select-row {
    margin: 0;
    padding: var(--pad-card-y) var(--pad-card-x);
    border: 0;
    border-top: 1px solid var(--border);
    min-width: 0;
    display: flow-root;
  }
  .select-row:first-child {
    border-top: 0;
  }
  /* A legend cannot be a grid item, so it floats into the label column and the
     answer takes the rest of the row. */
  .select-label {
    float: left;
    width: 220px;
    margin-right: var(--space-6);
    padding: 0;
    font-size: 14px;
    font-weight: 600;
  }
  .select-label span {
    display: block;
    margin-top: 2px;
    color: var(--muted-fg);
    font-size: 13px;
    font-weight: 400;
    line-height: 1.5;
  }
  .select-seg,
  .select-exts {
    margin-left: calc(220px + var(--space-6));
  }
  .select-seg {
    display: flex;
    flex-wrap: wrap;
    width: max-content;
    max-width: calc(100% - 220px - var(--space-6));
    gap: 2px;
    padding: 2px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--muted);
  }
  .select-seg label {
    display: flex;
    cursor: pointer;
  }
  .select-seg label span {
    padding: var(--space-1) var(--space-3);
    border-radius: var(--radius-sm);
    font-size: 14px;
    color: var(--muted-fg);
  }
  .select-seg label:hover span {
    color: var(--fg);
  }
  .select-seg input:checked + span {
    background: var(--bg);
    color: var(--fg);
    font-weight: 500;
    box-shadow: 0 0 0 1px var(--border);
  }
  .select-seg input:focus-visible + span {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .select-seg input:disabled + span {
    opacity: 0.45;
    cursor: not-allowed;
  }
  .select-exts {
    list-style: none;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .select-exts li + li {
    border-top: 1px solid var(--border);
  }
  .select-exts label {
    display: flex;
    align-items: center;
    gap: var(--gap-inline);
    padding: var(--space-2) var(--space-3);
    font-size: 14px;
    cursor: pointer;
  }
  .select-exts label:hover {
    background: var(--muted);
  }
  .select-exts li:has(input:checked) label {
    background: var(--accent-subtle);
  }
  .select-exts input {
    width: 16px;
    height: 16px;
    margin: 0;
    flex: none;
    accent-color: var(--primary);
  }
  .select-ext-title {
    font-weight: 500;
    min-width: 0;
  }
  .select-exts code {
    font-size: 12px;
    color: var(--muted-fg);
  }
  .select-ext-scope {
    margin-left: auto;
    flex: none;
    font-size: 12px;
    color: var(--muted-fg);
  }
  @media (max-width: 760px) {
    .select-label {
      float: none;
      width: auto;
      margin: 0 0 var(--space-3);
    }
    .select-seg,
    .select-exts {
      margin-left: 0;
    }
    .select-seg {
      max-width: 100%;
    }
    .select-exts code {
      display: none;
    }
  }
</style>
<script type="application/json" id="select-data" set:html={payload}></script>
<script is:inline>
(function () {
  var dataEl = document.getElementById("select-data");
  var form = document.getElementById("select-form");
  if (!dataEl || !form) return;
  var data = JSON.parse(dataEl.textContent || "{}");
  var origin = data.siteOrigin || "https://litespec.dev";

  function sameMembers(a, b) {
    if (a.length !== b.length) return false;
    return a.every(function (item) { return b.indexOf(item) !== -1; });
  }

  function joinList(items) {
    if (items.length === 0) return "none";
    if (items.length === 1) return items[0];
    if (items.length === 2) return items[0] + " and " + items[1];
    return items.slice(0, -1).join(", ") + " and " + items[items.length - 1];
  }

  function checkedValue(name) {
    var input = form.querySelector('input[name="' + name + '"]:checked');
    return input ? input.value : "";
  }

  function checkedExtensions() {
    var out = [];
    var boxes = form.querySelectorAll('input[data-extension-option]:checked');
    for (var i = 0; i < boxes.length; i++) out.push(boxes[i].value);
    return out;
  }

  function findSelection(shape, stacks) {
    for (var i = 0; i < data.selections.length; i++) {
      var entry = data.selections[i];
      if (entry.shape === shape && sameMembers(entry.stacks, stacks)) return entry;
    }
    return null;
  }

  function stacksFor(shape, backend, frontend) {
    if (shape === "server") {
      return frontend ? [backend, frontend] : [backend];
    }
    return frontend ? [frontend] : [];
  }

  function presetByName(name) {
    for (var i = 0; i < data.presets.length; i++) {
      if (data.presets[i].name === name) return data.presets[i];
    }
    return null;
  }

  function presetFor(shape, stacks) {
    for (var i = 0; i < data.presets.length; i++) {
      if (data.presets[i].shape === shape && sameMembers(data.presets[i].stacks, stacks)) {
        return data.presets[i];
      }
    }
    return null;
  }

  function applyPreset(name) {
    var preset = presetByName(name);
    if (!preset) return;
    var shapeInput = form.querySelector('input[name="shape"][value="' + preset.shape + '"]');
    if (shapeInput) shapeInput.checked = true;
    if (preset.shape === "server") {
      var backend = form.querySelector('input[name="backend"][value="' + (preset.stacks[0] || "") + '"]');
      if (backend) backend.checked = true;
      var frontend = preset.stacks[1]
        ? form.querySelector('input[name="frontend"][value="' + preset.stacks[1] + '"]')
        : form.querySelector('input[data-frontend-option="none"]');
      if (frontend) frontend.checked = true;
    } else {
      var only = form.querySelector('input[name="frontend"][value="' + (preset.stacks[0] || "") + '"]');
      if (only) only.checked = true;
    }
  }

  function syncPreset(shape, stacks) {
    var match = presetFor(shape, stacks);
    var inputs = form.querySelectorAll('input[data-preset-option]');
    for (var i = 0; i < inputs.length; i++) {
      inputs[i].checked = !!match && inputs[i].value === match.name;
    }
  }

  function setCopy(id, text) {
    var button = document.getElementById(id);
    if (button) button.setAttribute("data-copy", text);
  }

  function update(event) {
    if (
      event && event.target instanceof HTMLInputElement &&
      event.target.name === "preset" && event.target.checked
    ) {
      applyPreset(event.target.value);
    }

    var size = checkedValue("size") || data.defaultSize;
    var shape = checkedValue("shape") || data.defaultShape;
    var backend = checkedValue("backend") || data.defaultBackend;
    var frontend = checkedValue("frontend");
    if (shape !== "server") frontend = frontend || data.frontendStacks[0] || "";
    var stacks = stacksFor(shape, backend, frontend);

    var backendInputs = form.querySelectorAll('input[name="backend"]');
    for (var b = 0; b < backendInputs.length; b++) {
      backendInputs[b].disabled = shape !== "server";
    }
    var backendGroup = document.getElementById("select-backend-group");
    if (backendGroup) backendGroup.style.display = shape === "server" ? "" : "none";
    var backendNote = document.getElementById("select-backend-note");
    if (backendNote) {
      backendNote.textContent = shape === "server"
        ? "One backend stack for a server project."
        : "A client-only project has no backend stack.";
    }

    var frontendInputs = form.querySelectorAll('input[data-frontend-option]');
    for (var f = 0; f < frontendInputs.length; f++) {
      var option = frontendInputs[f].getAttribute("data-frontend-option");
      var candidate = option === "none" ? [] : [option];
      var valid;
      if (shape === "server") {
        valid = option === "none" || findSelection(shape, [backend, option]) !== null;
      } else {
        valid = option !== "none" && findSelection(shape, candidate) !== null;
      }
      frontendInputs[f].disabled = !valid;
      var field = frontendInputs[f].closest("label");
      if (field) {
        field.title = valid ? "" : "No published selection combines this stack with the other answers.";
      }
    }
    var checkedFrontend = form.querySelector('input[name="frontend"]:checked');
    if (checkedFrontend && checkedFrontend.disabled) {
      var firstValid = form.querySelector('input[data-frontend-option]:not(:disabled)');
      if (firstValid) {
        firstValid.checked = true;
        frontend = firstValid.value;
        stacks = stacksFor(shape, backend, frontend);
      }
    }

    var rows = form.querySelectorAll("[data-extension-row]");
    for (var r = 0; r < rows.length; r++) {
      var box = rows[r].querySelector('input[data-extension-option]');
      if (!box) continue;
      var need = box.getAttribute("data-extension-stack") || "";
      var applies = need === "" || stacks.indexOf(need) !== -1;
      rows[r].style.display = applies ? "" : "none";
      box.disabled = !applies;
      if (!applies) box.checked = false;
    }

    var selection = findSelection(shape, stacks);
    var indexAbsolute = selection ? origin + selection.indexUrl : origin + "/select/";
    var chosen = checkedExtensions();
    var layerById = {};
    for (var e = 0; e < data.extensions.length; e++) {
      layerById[data.extensions[e].id] = origin + data.extensions[e].layerUrl;
    }
    var agentText = [
      "## LiteSpec",
      "This project follows LiteSpec " + data.version + ": size " + size + ", shape " + shape +
        ", stacks " + joinList(stacks) + ", extensions " + (chosen.length ? chosen.join(", ") : "none") + ".",
      "Before a task, read " + indexAbsolute + " and fetch only the pages the task touches.",
      "Selected extensions: " + (chosen.length ? chosen.map(function (id) { return layerById[id]; }).join(", ") : "none"),
      "UI work: the pattern pages listed in that index.",
    ].join("\n");
    syncPreset(shape, stacks);

    var agents = document.getElementById("select-agents");
    if (agents) agents.textContent = agentText;

    setCopy("select-copy-agents", agentText);
  }

  form.addEventListener("change", update);

  update(null);
})();
</script>
