<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Analyzers load into every compiler host, so they target netstandard2.0. -->
        <TargetFramework>netstandard2.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <RootNamespace>LiteSpec.Analyzers</RootNamespace>
        <IsRoslynComponent>true</IsRoslynComponent>
        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <PackageId>LiteSpec.Analyzers</PackageId>
        <Version>3.0.0</Version>
        <Authors>Litenova Solutions</Authors>
        <Description>Roslyn analyzers that check a .NET application against the LiteSpec standard: layer boundaries, Domain modeling and naming. Every diagnostic links to the provision it enforces.</Description>
        <PackageTags>litespec;analyzers;roslyn;ddd;architecture</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageProjectUrl>https://litespec.dev</PackageProjectUrl>
        <RepositoryUrl>https://github.com/Litenova-Solutions/LiteSpec</RepositoryUrl>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <DevelopmentDependency>true</DevelopmentDependency>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
        <!--
            NU5128: the package ships an analyzer, not a library, so it has no lib folder.
            RS1012, RS1013: LayerAnalyzer registers each rule from its compilation start action and hands
            that context to Register, so the meta-analyzer cannot see the registrations it looks for.
        -->
        <NoWarn>$(NoWarn);NU5128;RS1012;RS1013</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <!-- The oldest compiler the package supports: the .NET 9.0.300 SDK and Visual Studio 17.14. -->
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" VersionOverride="4.14.0" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <!-- The shared rule library and the mark reader load beside the analyzers, so they ship in the analyzer folder. -->
        <ProjectReference Include="../../../model/src/LiteSpec.Model.Core/LiteSpec.Model.Core.csproj" PrivateAssets="all" />
        <ProjectReference Include="../../../model/src/LiteSpec.Model.Roslyn/LiteSpec.Model.Roslyn.csproj" PrivateAssets="all" />
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="AnalyzerReleases.Shipped.md" />
        <AdditionalFiles Include="AnalyzerReleases.Unshipped.md" />
    </ItemGroup>

    <ItemGroup>
        <!-- The provision ids LS5002 reads for follows marks, embedded at build time. -->
        <EmbeddedResource Include="..\..\..\..\docs\reference\provisions.md">
            <LogicalName>LiteSpec.Provisions.md</LogicalName>
        </EmbeddedResource>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="LiteSpec.Analyzers.Tests" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(OutputPath)$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)LiteSpec.Model.Core.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="$(OutputPath)LiteSpec.Model.Roslyn.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <!-- The code fixes build in their own project, which references this one; pack the solution build of it. -->
        <None Include="../LiteSpec.Analyzers.CodeFixes/$(OutputPath)LiteSpec.Analyzers.CodeFixes.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
        <None Include="build/LiteSpec.Analyzers.props" Pack="true" PackagePath="build" />
        <None Include="README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <!--
        The code fixes reference this project, so this project cannot reference them back. Pack builds them
        in the configuration being packed first, so the package never depends on an earlier build having run.
    -->
    <Target Name="BuildCodeFixesForPack" BeforeTargets="_GetPackageFiles">
        <MSBuild Projects="../LiteSpec.Analyzers.CodeFixes/LiteSpec.Analyzers.CodeFixes.csproj" Targets="Build" Properties="Configuration=$(Configuration)" />
    </Target>

</Project>
