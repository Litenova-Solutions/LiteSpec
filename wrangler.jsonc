// litespec.dev on Cloudflare Workers: a static-assets-only Worker, so every request is served
// from apps/site/dist without running a script. The site build writes dist/_redirects (/latest).
// Workers Builds deploys it on every push to main and builds a Preview for every other branch.
{
  "$schema": "./apps/site/node_modules/wrangler/config-schema.json",
  "name": "litespec-site",
  "account_id": "864f2fee2367d77cf443122378ca1366",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./apps/site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "litespec.dev", "custom_domain": true }
  ],
  // workers.dev stays off so search engines index one copy. Preview URLs are on: each
  // branch build gets a workers.dev Preview, which Cloudflare serves with noindex.
  "workers_dev": false,
  "preview_urls": true,
  // `wrangler preview` needs this block. The site has no bindings, so it stays empty.
  "previews": {},
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
