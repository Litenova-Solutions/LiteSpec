{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "litespec-site",
  "compatibility_date": "2026-10-01",
  // `wrangler deploy` and `wrangler preview` build the site first, so the Worker needs no build command of its own.
  // The build writes apps/site/dist, which the Worker serves as static assets. It runs at the repository root, where
  // the workspace lockfile and the root package.json that names pnpm live; corepack reads that version.
  "build": {
    "command": "corepack enable && pnpm install --frozen-lockfile && pnpm --dir apps/site build"
  },
  "assets": {
    "directory": "./apps/site/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // A branch other than main builds a Preview with `wrangler preview`, which needs this block. The site has no
  // bindings, so it stays empty. Previews are served on subdomains of litespec.dev (<preview-name>.litespec.dev),
  // which the previews_enabled route below turns on once main deploys; every page names its litespec.dev address as
  // canonical, so a Preview is not indexed as a second site. workers.dev serves no Preview.
  "previews": {},
  "preview_urls": false,
  "routes": [
    { "pattern": "litespec.dev", "custom_domain": true, "previews_enabled": true }
  ]
}
