<Project>
    <!--
        The one source of package versions for the LiteSpec repository's own
        tools. Kept beside Directory.Build.props so central versions in a
        parent folder do not apply inside the LiteSpec repository.
    -->
    <ItemGroup>
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>
</Project>
