<Project>
    <!--
        The one source of package versions for the LiteSpec repository's own
        tools. Kept beside Directory.Build.props so central versions in a
        parent folder do not apply inside the LiteSpec repository.
    -->
    <ItemGroup>
        <PackageVersion Include="Markdig" Version="1.4.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
        <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
        <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="10.0.402" />
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="xunit.v3" Version="4.0.2" />
    </ItemGroup>
</Project>
